<Window x:Class="YunX.Desktop.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:shell="clr-namespace:System.Windows.Shell;assembly=PresentationFramework"
        xmlns:vm="clr-namespace:YunX.Desktop.ViewModels"
        xmlns:views="clr-namespace:YunX.Desktop.Views"
        Title="YunX Desktop"
        Icon="Assets/app.ico"
        Height="780" Width="1180" MinHeight="620" MinWidth="920"
        Background="{StaticResource BgBrush}"
        WindowStartupLocation="CenterScreen"
        UseLayoutRounding="True"
        SnapsToDevicePixels="True"
        TextOptions.TextFormattingMode="Display">

    <!-- 自绘标题栏：系统默认标题栏是浅色的，和深色界面拼在一起很割裂 -->
    <shell:WindowChrome.WindowChrome>
        <shell:WindowChrome CaptionHeight="48"
                            ResizeBorderThickness="6"
                            GlassFrameThickness="0"
                            CornerRadius="0"
                            UseAeroCaptionButtons="False" />
    </shell:WindowChrome.WindowChrome>

    <Window.DataContext>
        <vm:MainViewModel />
    </Window.DataContext>

    <Border Background="{StaticResource WindowBackdrop}">
        <Grid>
            <Grid.RowDefinitions>
                <RowDefinition Height="48" />
                <RowDefinition Height="*" />
                <RowDefinition Height="Auto" />
            </Grid.RowDefinitions>

            <!-- ================= 标题栏 ================= -->
            <Grid Grid.Row="0" Background="Transparent">
                <StackPanel Orientation="Horizontal" Margin="16,0,0,0" VerticalAlignment="Center">
                    <Border Width="26" Height="26" CornerRadius="7"
                            Background="{DynamicResource AccentGradient}">
                        <Path Data="{StaticResource IconDownload}" Fill="#FFFFFF"
                              Width="15" Height="15" Stretch="Uniform"
                              HorizontalAlignment="Center" VerticalAlignment="Center" />
                    </Border>
                    <TextBlock Text="YunX Desktop" FontSize="13.5" FontWeight="SemiBold"
                               Margin="10,0,0,0" VerticalAlignment="Center" />
                    <Border Style="{StaticResource Badge}" Margin="9,0,0,0">
                        <TextBlock Text="C#" FontSize="10"
                                   Foreground="{StaticResource TextMutedBrush}" />
                    </Border>
                </StackPanel>

                <!-- 窗口按钮要显式声明可点击，否则会被当成标题栏拖拽区吃掉点击 -->
                <StackPanel Orientation="Horizontal" HorizontalAlignment="Right"
                            shell:WindowChrome.IsHitTestVisibleInChrome="True">
                    <Button Style="{StaticResource CaptionButton}" Click="OnMinimize"
                            ToolTip="最小化">
                        <Path Data="{StaticResource IconMinimize}"
                              Fill="{Binding Foreground,
                                RelativeSource={RelativeSource AncestorType=Button}}"
                              Width="11" Height="11" Stretch="Uniform" />
                    </Button>
                    <Button Style="{StaticResource CaptionButton}"
                            Click="OnMaximizeRestore" ToolTip="最大化">
                        <Path x:Name="MaxIcon" Data="{StaticResource IconMaximize}"
                              Fill="{Binding Foreground,
                                RelativeSource={RelativeSource AncestorType=Button}}"
                              Width="10" Height="10" Stretch="Uniform" />
                    </Button>
                    <Button Style="{StaticResource CloseCaptionButton}" Click="OnClose"
                            ToolTip="关闭">
                        <Path Data="{StaticResource IconClose}"
                              Fill="{Binding Foreground,
                                RelativeSource={RelativeSource AncestorType=Button}}"
                              Width="11" Height="11" Stretch="Uniform" />
                    </Button>
                </StackPanel>
            </Grid>

            <!-- ================= 主体 ================= -->
            <Grid Grid.Row="1">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="204" />
                    <ColumnDefinition Width="*" />
                </Grid.ColumnDefinitions>

                <!-- ========== 侧边导航 ========== -->
                <Grid Grid.Column="0">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="*" />
                        <RowDefinition Height="Auto" />
                    </Grid.RowDefinitions>
                    <StackPanel Margin="0,10,0,0">
                        <ToggleButton Style="{StaticResource NavItem}"
                                      IsChecked="{Binding Page,
                                        Converter={StaticResource EnumEquals},
                                        ConverterParameter=Parse, Mode=OneWay}"
                                      Command="{Binding NavigateCommand}"
                                      CommandParameter="parse">
                            <StackPanel Orientation="Horizontal">
                                <Path Data="{StaticResource IconLink}" Width="17" Height="17"
                                      Stretch="Uniform" VerticalAlignment="Center"
                                      Fill="{Binding Foreground, RelativeSource={RelativeSource AncestorType=ToggleButton}}" />
                                <TextBlock Text="解析" FontSize="13" Margin="12,0,0,0"
                                           VerticalAlignment="Center"
                                           Foreground="{Binding Foreground, RelativeSource={RelativeSource AncestorType=ToggleButton}}" />
                            </StackPanel>
                        </ToggleButton>

                        <ToggleButton Style="{StaticResource NavItem}"
                                      IsChecked="{Binding Page,
                                        Converter={StaticResource EnumEquals},
                                        ConverterParameter=Downloads, Mode=OneWay}"
                                      Command="{Binding NavigateCommand}"
                                      CommandParameter="downloads">
                            <Grid>
                                <StackPanel Orientation="Horizontal">
                                    <Path Data="{StaticResource IconDownload}" Width="17" Height="17"
                                          Stretch="Uniform" VerticalAlignment="Center"
                                          Fill="{Binding Foreground, RelativeSource={RelativeSource AncestorType=ToggleButton}}" />
                                    <TextBlock Text="下载" FontSize="13" Margin="12,0,0,0"
                                               VerticalAlignment="Center"
                                               Foreground="{Binding Foreground, RelativeSource={RelativeSource AncestorType=ToggleButton}}" />
                                </StackPanel>
                                <Border HorizontalAlignment="Right" CornerRadius="8"
                                        Background="{DynamicResource AccentBrush}"
                                        Padding="6,1" VerticalAlignment="Center"
                                        Visibility="{Binding RunningBadgeVisible,
                                          Converter={StaticResource BoolToVis}}">
                                    <TextBlock Text="{Binding RunningBadgeText}" FontSize="10"
                                               Foreground="#FFFFFF" FontWeight="SemiBold" />
                                </Border>
                            </Grid>
                        </ToggleButton>

                        <ToggleButton Style="{StaticResource NavItem}"
                                      IsChecked="{Binding Page,
                                        Converter={StaticResource EnumEquals},
                                        ConverterParameter=Accounts, Mode=OneWay}"
                                      Command="{Binding NavigateCommand}"
                                      CommandParameter="accounts">
                            <Grid>
                                <StackPanel Orientation="Horizontal">
                                    <Path Data="{StaticResource IconGlobe}" Width="17" Height="17"
                                          Stretch="Uniform" VerticalAlignment="Center"
                                          Fill="{Binding Foreground, RelativeSource={RelativeSource AncestorType=ToggleButton}}" />
                                    <TextBlock Text="账号" FontSize="13" Margin="12,0,0,0"
                                               VerticalAlignment="Center"
                                               Foreground="{Binding Foreground, RelativeSource={RelativeSource AncestorType=ToggleButton}}" />
                                </StackPanel>
                            </Grid>
                        </ToggleButton>

                        <!-- 收藏：独立页面，替代原先挤在侧边栏下方的紧凑列表 -->
                        <ToggleButton Style="{StaticResource NavItem}"
                                      IsChecked="{Binding Page,
                                        Converter={StaticResource EnumEquals},
                                        ConverterParameter=Favorites, Mode=OneWay}"
                                      Command="{Binding NavigateCommand}"
                                      CommandParameter="favorites">
                            <Grid>
                                <StackPanel Orientation="Horizontal">
                                    <Path Data="{StaticResource IconStar}" Width="16" Height="16"
                                          Stretch="Uniform" VerticalAlignment="Center"
                                          Fill="{Binding Foreground, RelativeSource={RelativeSource AncestorType=ToggleButton}}" />
                                    <TextBlock Text="收藏" FontSize="13" Margin="12,0,0,0"
                                               VerticalAlignment="Center"
                                               Foreground="{Binding Foreground, RelativeSource={RelativeSource AncestorType=ToggleButton}}" />
                                </StackPanel>
                                <Border HorizontalAlignment="Right" CornerRadius="8"
                                        Background="{StaticResource SurfaceTopBrush}"
                                        Padding="6,1" VerticalAlignment="Center"
                                        Visibility="{Binding HasFavorites, Converter={StaticResource BoolToVis}}">
                                    <TextBlock Text="{Binding Favorites.Count}" FontSize="10"
                                               Foreground="{StaticResource TextMutedBrush}" FontWeight="SemiBold" />
                                </Border>
                            </Grid>
                        </ToggleButton>

                        <ToggleButton Style="{StaticResource NavItem}"
                                      IsChecked="{Binding Page,
                                        Converter={StaticResource EnumEquals},
                                        ConverterParameter=Debug, Mode=OneWay}"
                                      Command="{Binding NavigateCommand}"
                                      CommandParameter="debug">
                            <Grid>
                                <StackPanel Orientation="Horizontal">
                                    <Path Data="{StaticResource IconBolt}" Width="17" Height="17"
                                          Stretch="Uniform" VerticalAlignment="Center"
                                          Fill="{Binding Foreground, RelativeSource={RelativeSource AncestorType=ToggleButton}}" />
                                    <TextBlock Text="调试" FontSize="13" Margin="12,0,0,0"
                                               VerticalAlignment="Center"
                                               Foreground="{Binding Foreground, RelativeSource={RelativeSource AncestorType=ToggleButton}}" />
                                </StackPanel>
                            </Grid>
                        </ToggleButton>

                        <ToggleButton Style="{StaticResource NavItem}"
                                      IsChecked="{Binding Page,
                                        Converter={StaticResource EnumEquals},
                                        ConverterParameter=Settings, Mode=OneWay}"
                                      Command="{Binding NavigateCommand}"
                                      CommandParameter="settings">
                            <StackPanel Orientation="Horizontal">
                                <Path Data="{StaticResource IconSettings}" Width="17" Height="17"
                                      Stretch="Uniform" VerticalAlignment="Center"
                                      Fill="{Binding Foreground, RelativeSource={RelativeSource AncestorType=ToggleButton}}" />
                                <TextBlock Text="设置" FontSize="13" Margin="12,0,0,0"
                                           VerticalAlignment="Center"
                                           Foreground="{Binding Foreground, RelativeSource={RelativeSource AncestorType=ToggleButton}}" />
                            </StackPanel>
                        </ToggleButton>
                    </StackPanel>


                    <Button Grid.Row="2" Style="{StaticResource IconButton}"
                            Command="{Binding OpenDirCommand}"
                            HorizontalAlignment="Left" Margin="14,0,0,14"
                            Width="Auto" Height="32" ToolTip="打开下载目录">
                        <StackPanel Orientation="Horizontal" Margin="8,0">
                            <Path Data="{StaticResource IconFolder}" Width="15" Height="15"
                                  Stretch="Uniform" VerticalAlignment="Center"
                                  Fill="{StaticResource TextMutedBrush}" />
                            <TextBlock Text="下载目录" FontSize="12" Margin="8,0,0,0"
                                       VerticalAlignment="Center"
                                       Foreground="{StaticResource TextMutedBrush}" />
                        </StackPanel>
                    </Button>
                </Grid>

                <Border Grid.Column="0" Width="1" HorizontalAlignment="Right"
                        Background="{StaticResource BorderBrush}" Margin="0,8,0,8" />

                <!-- ================= 内容区 ================= -->
                <Grid Grid.Column="1">

                    <!-- ========== 收藏页 ========== -->
                    <Grid Visibility="{Binding IsFavoritesPage, Converter={StaticResource BoolToVis}}">
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="*" />
                        </Grid.RowDefinitions>

                        <!-- 标题栏 -->
                        <Grid Margin="34,24,34,0">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>

                            <StackPanel>
                                <TextBlock Text="收藏" Style="{StaticResource PageTitle}" />
                                <TextBlock Text="常用的链接固定在这里，点一行即可载入并解析。可自定义名称，未命名的显示网址"
                                           Style="{StaticResource MutedText}" Margin="0,7,0,0" />
                            </StackPanel>

                            <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Bottom">
                                <Button Style="{StaticResource GhostButton}"
                                        Content="清空全部" FontSize="12" Padding="14,6"
                                        Command="{Binding ClearAllFavoritesCommand}"
                                        Visibility="{Binding HasFavorites, Converter={StaticResource BoolToVis}}" />
                            </StackPanel>
                        </Grid>

                        <ScrollViewer Grid.Row="1" Style="{StaticResource SlimScrollViewer}"
                                      VerticalScrollBarVisibility="Auto" Margin="0,16,0,0">
                            <StackPanel Margin="34,0,34,26" MaxWidth="760"
                                        HorizontalAlignment="Center" Width="760">

                                <!-- 空态 -->
                                <Border Style="{StaticResource Card}" Padding="30"
                                        Visibility="{Binding HasFavorites,
                                          Converter={StaticResource InverseBoolToVis}}">
                                    <StackPanel HorizontalAlignment="Center">
                                        <Path Data="{StaticResource IconStar}" Width="30" Height="30"
                                              Stretch="Uniform" HorizontalAlignment="Center"
                                              Fill="{StaticResource TextDimBrush}" Opacity="0.5" />
                                        <TextBlock Text="还没有收藏" FontSize="13" Margin="0,14,0,0"
                                                   HorizontalAlignment="Center"
                                                   Foreground="{StaticResource TextBrush}" />
                                        <TextBlock Text="解析出结果后，点结果卡片上的「收藏」就会出现在这里。"
                                                   Style="{StaticResource CaptionText}"
                                                   Margin="0,7,0,0" HorizontalAlignment="Center" />
                                        <Button Style="{StaticResource GhostButton}" Content="去解析"
                                                Margin="0,16,0,0" Padding="20,7" FontSize="12"
                                                HorizontalAlignment="Center"
                                                Command="{Binding NavigateCommand}"
                                                CommandParameter="parse" />
                                    </StackPanel>
                                </Border>

                                <!-- 列表：每行 = 名称 + 网址 + 操作 -->
                                <ItemsControl ItemsSource="{Binding Favorites}"
                                              Visibility="{Binding HasFavorites,
                                                Converter={StaticResource BoolToVis}}">
                                    <ItemsControl.ItemTemplate>
                                        <DataTemplate>
                                            <Border Style="{StaticResource Card}" Padding="16,13"
                                                    Margin="0,0,0,10">
                                                <Grid>
                                                    <Grid.ColumnDefinitions>
                                                        <ColumnDefinition Width="*" />
                                                        <ColumnDefinition Width="Auto" />
                                                    </Grid.ColumnDefinitions>

                                                    <!-- 点这块载入（不是整行：右侧按钮在行内，整行可点会互相抢） -->
                                                    <Button Grid.Column="0"
                                                            Background="Transparent" BorderThickness="0"
                                                            HorizontalContentAlignment="Left"
                                                            Cursor="Hand" Padding="0"
                                                            Command="{Binding DataContext.UseFavoriteCommand,
                                                                      RelativeSource={RelativeSource AncestorType=ItemsControl}}"
                                                            CommandParameter="{Binding}">
                                                        <Button.Template>
                                                            <ControlTemplate TargetType="Button">
                                                                <Border Background="Transparent">
                                                                    <ContentPresenter />
                                                                </Border>
                                                            </ControlTemplate>
                                                        </Button.Template>
                                                        <StackPanel>
                                                            <StackPanel Orientation="Horizontal">
                                                                <TextBlock Text="{Binding DisplayLabel}"
                                                                           FontSize="13"
                                                                           Foreground="{StaticResource TextBrush}"
                                                                           TextTrimming="CharacterEllipsis" />
                                                                <!-- 有自定义名时标一下，让用户知道哪个是自己起的名 -->
                                                                <Border Style="{StaticResource Badge}"
                                                                        Margin="8,0,0,0" Padding="5,1.5"
                                                                        Visibility="{Binding LabelCustom,
                                                                          Converter={StaticResource BoolToVis}}">
                                                                    <TextBlock Text="自定义" FontSize="9.5"
                                                                               Foreground="{StaticResource TextMutedBrush}" />
                                                                </Border>
                                                            </StackPanel>
                                                            <TextBlock Text="{Binding RawInput}"
                                                                       FontSize="10.5" Margin="0,4,0,0"
                                                                       TextTrimming="CharacterEllipsis"
                                                                       Foreground="{StaticResource TextDimBrush}" />
                                                        </StackPanel>
                                                    </Button>

                                                    <StackPanel Grid.Column="1" Orientation="Horizontal"
                                                                VerticalAlignment="Center" Margin="14,0,0,0">
                                                        <Button Style="{StaticResource SmallButton}"
                                                                Content="载入" Padding="11,4"
                                                                Command="{Binding DataContext.UseFavoriteCommand,
                                                                          RelativeSource={RelativeSource AncestorType=ItemsControl}}"
                                                                CommandParameter="{Binding}" />
                                                        <Button Style="{StaticResource SmallButton}"
                                                                Content="重命名" Padding="11,4" Margin="6,0,0,0"
                                                                Command="{Binding DataContext.RenameFavoriteCommand,
                                                                          RelativeSource={RelativeSource AncestorType=ItemsControl}}"
                                                                CommandParameter="{Binding}" />
                                                        <Button Style="{StaticResource SmallButton}"
                                                                Content="删除" Padding="11,4" Margin="6,0,0,0"
                                                                Command="{Binding DataContext.RemoveFavoriteCommand,
                                                                          RelativeSource={RelativeSource AncestorType=ItemsControl}}"
                                                                CommandParameter="{Binding}" />
                                                    </StackPanel>
                                                </Grid>
                                            </Border>
                                        </DataTemplate>
                                    </ItemsControl.ItemTemplate>
                                </ItemsControl>
                            </StackPanel>
                        </ScrollViewer>
                    </Grid>

                    <!-- ========== 解析页 ========== -->
                    <Grid Visibility="{Binding IsParsePage, Converter={StaticResource BoolToVis}}">
                        <ScrollViewer x:Name="ParseScrollViewer"
                                      Style="{StaticResource SlimScrollViewer}"
                                      VerticalScrollBarVisibility="Auto"
                                      Margin="0,0,4,0">
                            <StackPanel Margin="34,26,34,26" MaxWidth="760"
                                        HorizontalAlignment="Center" Width="760">

                                <TextBlock Text="解析链接" Style="{StaticResource PageTitle}" />
                                <TextBlock Text="粘贴 GitHub 链接或网盘分享（含提取码），自动识别来源并择优下载"
                                           Style="{StaticResource MutedText}" Margin="0,7,0,0" />

                                <Border Style="{StaticResource Card}" Padding="18" Margin="0,22,0,0">
                                    <StackPanel>
                                        <Grid>
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="*" />
                                                <ColumnDefinition Width="Auto" />
                                            </Grid.ColumnDefinitions>
                                            <Grid>
                                                <TextBox x:Name="InputBox" Style="{StaticResource InputBox}"
                                                         Text="{Binding InputText, UpdateSourceTrigger=PropertyChanged}"
                                                         FontSize="14" Padding="13,0" Height="44"
                                                         KeyDown="OnInputKeyDown" />
                                                <TextBlock Text="粘贴 GitHub 链接或网盘分享链接…"
                                                           IsHitTestVisible="False"
                                                           Margin="15,0,0,0"
                                                           VerticalAlignment="Center"
                                                           FontSize="14"
                                                           Foreground="{StaticResource TextDimBrush}"
                                                           Visibility="{Binding InputText,
                                                             Converter={StaticResource EmptyToVis}}" />
                                            </Grid>
                                            <Button Grid.Column="1" Style="{StaticResource GhostButton}"
                                                    Command="{Binding PasteCommand}"
                                                    Margin="8,0,0,0" Padding="14,11"
                                                    Content="粘贴" />
                                        </Grid>

                                        <WrapPanel Margin="0,11,0,0">
                                            <TextBlock Text="试试："
                                                       Style="{StaticResource CaptionText}"
                                                       VerticalAlignment="Center"
                                                       Margin="0,0,4,0" />
                                            <Button Style="{StaticResource SampleChip}"
                                                    Command="{Binding UseSampleCommand}"
                                                    CommandParameter="repo" Content="仓库" />
                                            <Button Style="{StaticResource SampleChip}"
                                                    Command="{Binding UseSampleCommand}"
                                                    CommandParameter="release" Content="Release" />
                                            <Button Style="{StaticResource SampleChip}"
                                                    Command="{Binding UseSampleCommand}"
                                                    CommandParameter="file" Content="单文件" />
                                        </WrapPanel>

                                        <StackPanel Orientation="Horizontal" Margin="0,16,0,0">
                                            <Button Style="{StaticResource PrimaryButton}"
                                                    Command="{Binding ParseCommand}"
                                                    Content="解析" MinWidth="96" />
                                            <Button Style="{StaticResource GhostButton}"
                                                    Command="{Binding DownloadCommand}"
                                                    Content="开始下载" Margin="10,0,0,0"
                                                    MinWidth="104" Padding="18,9" />
                                            <TextBlock Text="回车即可解析"
                                                       Style="{StaticResource CaptionText}"
                                                       VerticalAlignment="Center"
                                                       Margin="14,0,0,0" />
                                        </StackPanel>
                                    </StackPanel>
                                </Border>

                                <Border Style="{StaticResource Card}" Padding="18" Margin="0,14,0,0"
                                        Visibility="{Binding HasParsed,
                                          Converter={StaticResource BoolToVis}}">
                                    <StackPanel>
                                        <Grid>
                                            <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                                <TextBlock Text="解析结果"
                                                           Style="{StaticResource SectionTitle}" />
                                                <Border Style="{StaticResource Badge}" Margin="10,0,0,0"
                                                        VerticalAlignment="Center">
                                                    <TextBlock Text="{Binding ParsedKind}" FontSize="10.5"
                                                               Foreground="{StaticResource TextMutedBrush}"
                                                               TextTrimming="CharacterEllipsis"
                                                               MaxWidth="160" />
                                                </Border>
                                            </StackPanel>
                                            <StackPanel Orientation="Horizontal"
                                                        HorizontalAlignment="Right"
                                                        VerticalAlignment="Center">
                                                <!-- 浏览仓库：GitHubBrowser 早就实现好了（ListDirectoryAsync /
                                                     GetReadmeAsync），但 UI 一直没有入口，等于功能不存在。 -->
                                                <Button Style="{StaticResource GhostButton}"
                                                        Content="浏览仓库" FontSize="11.5" Padding="10,4"
                                                        Command="{Binding BrowseRepoCommand}"
                                                        Visibility="{Binding CanBrowseRepo,
                                                          Converter={StaticResource BoolToVis}}" />
                                                <!-- README 预览：MarkdownParser 早已实现并有断言覆盖，
                                                     但一直没有消费者，用户看到的还是纯文本。 -->
                                                <Button Style="{StaticResource GhostButton}"
                                                        Content="README" FontSize="11.5" Padding="10,4"
                                                        Margin="6,0,0,0"
                                                        Command="{Binding ShowReadmeCommand}"
                                                        Visibility="{Binding CanBrowseRepo,
                                                          Converter={StaticResource BoolToVis}}" />
                                                <!-- 收藏 / 复制链接：命令早就写好了，但 XAML 里一直没绑定，
                                                     用户完全触达不到。 -->
                                                <Button Style="{StaticResource GhostButton}"
                                                        Content="{Binding FavoriteButtonText}" FontSize="11.5" Padding="10,4"
                                                        Margin="6,0,0,0"
                                                        Command="{Binding ToggleFavoriteCommand}" />
                                                <Button Style="{StaticResource GhostButton}"
                                                        Content="复制链接" FontSize="11.5" Padding="10,4"
                                                        Margin="6,0,0,0"
                                                        Command="{Binding CopyLinkCommand}" />
                                            </StackPanel>
                                        </Grid>

                                        <!-- ===== 仓库文件树（点「浏览仓库」展开） ===== -->
                                        <Border Margin="0,12,0,0" Padding="12"
                                                CornerRadius="8"
                                                Background="{StaticResource SurfaceHiBrush}"
                                                Visibility="{Binding BrowserOpen,
                                                  Converter={StaticResource BoolToVis}}">
                                            <StackPanel>
                                                <Grid>
                                                    <Grid.ColumnDefinitions>
                                                        <ColumnDefinition Width="Auto" />
                                                        <ColumnDefinition Width="*" />
                                                        <ColumnDefinition Width="Auto" />
                                                    </Grid.ColumnDefinitions>
                                                    <Button Grid.Column="0" Style="{StaticResource GhostButton}"
                                                            Content="返回上级" FontSize="11" Padding="8,3"
                                                            Command="{Binding BrowserBackCommand}"
                                                            Visibility="{Binding CanBrowserBack,
                                                              Converter={StaticResource BoolToVis}}" />
                                                    <TextBlock Grid.Column="1" Text="{Binding BrowserPathText}"
                                                               FontSize="11.5"
                                                               VerticalAlignment="Center"
                                                               Margin="10,0"
                                                               TextTrimming="CharacterEllipsis"
                                                               Foreground="{StaticResource TextMutedBrush}" />
                                                    <Button Grid.Column="2" Style="{StaticResource GhostButton}"
                                                            Content="关闭" FontSize="11" Padding="8,3"
                                                            Command="{Binding BrowserCloseCommand}" />
                                                </Grid>

                                                <ScrollViewer MaxHeight="260" Margin="0,8,0,0"
                                                              VerticalScrollBarVisibility="Auto"
                                                              Style="{StaticResource SlimScrollViewer}">
                                                    <ItemsControl ItemsSource="{Binding BrowserEntries}">
                                                        <ItemsControl.ItemTemplate>
                                                            <DataTemplate>
                                                                <Button HorizontalContentAlignment="Stretch"
                                                                        Background="Transparent"
                                                                        BorderThickness="0"
                                                                        Padding="6,5"
                                                                        Cursor="Hand"
                                                                        Command="{Binding DataContext.BrowserActivateCommand,
                                                                          RelativeSource={RelativeSource AncestorType=Window}}"
                                                                        CommandParameter="{Binding}">
                                                                    <Grid>
                                                                        <Grid.ColumnDefinitions>
                                                                            <ColumnDefinition Width="Auto" />
                                                                            <ColumnDefinition Width="*" />
                                                                            <ColumnDefinition Width="Auto" />
                                                                        </Grid.ColumnDefinitions>
                                                                        <Path Grid.Column="0" Width="13" Height="13"
                                                                              Stretch="Uniform"
                                                                              VerticalAlignment="Center"
                                                                              Data="{StaticResource IconFolder}"
                                                                              Fill="{StaticResource TextMutedBrush}">
                                                                            <!-- 文件换成通用文档图标；目录保留文件夹。
                                                                                 用 Style 触发器而不是两套模板，避免重复整段布局。 -->
                                                                            <Path.Style>
                                                                                <Style TargetType="Path">
                                                                                    <Style.Triggers>
                                                                                        <DataTrigger Binding="{Binding IsDirectory}" Value="False">
                                                                                            <Setter Property="Data"
                                                                                                    Value="{StaticResource IconFile}" />
                                                                                        </DataTrigger>
                                                                                    </Style.Triggers>
                                                                                </Style>
                                                                            </Path.Style>
                                                                        </Path>
                                                                        <TextBlock Grid.Column="1" Text="{Binding Name}"
                                                                                   FontSize="12" Margin="8,0"
                                                                                   VerticalAlignment="Center"
                                                                                   TextTrimming="CharacterEllipsis" />
                                                                        <TextBlock Grid.Column="2" Text="{Binding SizeText}"
                                                                                   FontSize="11"
                                                                                   VerticalAlignment="Center"
                                                                                   Foreground="{StaticResource TextDimBrush}" />
                                                                    </Grid>
                                                                </Button>
                                                            </DataTemplate>
                                                        </ItemsControl.ItemTemplate>
                                                    </ItemsControl>
                                                </ScrollViewer>
                                            </StackPanel>
                                        </Border>

                                        <!-- ===== README 预览（GFM 渲染） ===== -->
                                        <Border Margin="0,12,0,0" Padding="14"
                                                CornerRadius="8"
                                                Background="{StaticResource SurfaceHiBrush}"
                                                Visibility="{Binding ReadmeOpen,
                                                  Converter={StaticResource BoolToVis}}">
                                            <StackPanel>
                                                <Grid Margin="0,0,0,8">
                                                    <TextBlock Text="README" FontSize="12.5"
                                                               FontWeight="Medium"
                                                               VerticalAlignment="Center" />
                                                    <Button Style="{StaticResource GhostButton}"
                                                            Content="关闭" FontSize="11" Padding="8,3"
                                                            HorizontalAlignment="Right"
                                                            Command="{Binding CloseReadmeCommand}" />
                                                </Grid>

                                                <TextBlock Text="{Binding ReadmeError}"
                                                           FontSize="11.5"
                                                           Foreground="{StaticResource ErrBrush}"
                                                           TextWrapping="Wrap" />

                                                <ScrollViewer MaxHeight="380"
                                                              VerticalScrollBarVisibility="Auto"
                                                              Style="{StaticResource SlimScrollViewer}">
                                                    <ItemsControl ItemsSource="{Binding ReadmeBlocks}">
                                                        <ItemsControl.ItemTemplate>
                                                            <DataTemplate>
                                                                <Grid Margin="{Binding BlockMargin}">
                                                                    <!-- 标题 -->
                                                                    <StackPanel Visibility="{Binding IsHeading,
                                                                                      Converter={StaticResource BoolToVis}}">
                                                                        <TextBlock Text="{Binding Text}"
                                                                                   FontSize="{Binding HeadingFontSize}"
                                                                                   FontWeight="{Binding HeadingWeight}"
                                                                                   TextWrapping="Wrap" />
                                                                        <Border Height="1" Margin="0,6,0,0"
                                                                                Background="{StaticResource BorderBrush}"
                                                                                Visibility="{Binding HeadingRuleVisibility}" />
                                                                    </StackPanel>

                                                                    <!-- 段落（行内格式混排） -->
                                                                    <TextBlock TextWrapping="Wrap" LineHeight="21"
                                                                               FontSize="12.5"
                                                                               Visibility="{Binding IsParagraph,
                                                                                 Converter={StaticResource BoolToVis}}"
                                                                               views:MdInlineText.Inlines="{Binding Inlines}" />

                                                                    <!-- 引用 -->
                                                                    <Border BorderThickness="3,0,0,0"
                                                                            BorderBrush="{StaticResource BorderHiBrush}"
                                                                            Padding="10,2,0,2"
                                                                            Visibility="{Binding IsQuote,
                                                                              Converter={StaticResource BoolToVis}}">
                                                                        <TextBlock TextWrapping="Wrap" LineHeight="20"
                                                                                   FontSize="12.5"
                                                                                   Foreground="{StaticResource TextMutedBrush}"
                                                                                   views:MdInlineText.Inlines="{Binding Inlines}" />
                                                                    </Border>

                                                                    <!-- 代码块 -->
                                                                    <Border Background="{StaticResource SurfaceTopBrush}"
                                                                            CornerRadius="6" Padding="12,10"
                                                                            Visibility="{Binding IsCode,
                                                                              Converter={StaticResource BoolToVis}}">
                                                                        <StackPanel>
                                                                            <TextBlock Text="{Binding Language}"
                                                                                       FontSize="10.5"
                                                                                       Margin="0,0,0,5"
                                                                                       Foreground="{StaticResource TextDimBrush}"
                                                                                       Visibility="{Binding LanguageVisibility}" />
                                                                            <TextBox Text="{Binding Text, Mode=OneWay}"
                                                                                     IsReadOnly="True"
                                                                                     BorderThickness="0"
                                                                                     Background="Transparent"
                                                                                     FontFamily="Consolas, Microsoft YaHei UI"
                                                                                     FontSize="12"
                                                                                     TextWrapping="NoWrap"
                                                                                     HorizontalScrollBarVisibility="Auto"
                                                                                     VerticalScrollBarVisibility="Disabled"
                                                                                     Padding="0" />
                                                                        </StackPanel>
                                                                    </Border>

                                                                    <!-- 列表项 -->
                                                                    <Grid Visibility="{Binding IsList,
                                                                              Converter={StaticResource BoolToVis}}">
                                                                        <Grid.ColumnDefinitions>
                                                                            <ColumnDefinition Width="Auto" />
                                                                            <ColumnDefinition Width="*" />
                                                                        </Grid.ColumnDefinitions>
                                                                        <TextBlock Grid.Column="0" Text="•"
                                                                                   FontSize="12.5" Margin="0,0,7,0"
                                                                                   VerticalAlignment="Top"
                                                                                   Foreground="{StaticResource TextMutedBrush}" />
                                                                        <TextBlock Grid.Column="1" TextWrapping="Wrap"
                                                                                   LineHeight="20" FontSize="12.5"
                                                                                   views:MdInlineText.Inlines="{Binding Bullet}" />
                                                                    </Grid>

                                                                    <!-- 表格：用只读的等宽化 Grid 简化呈现 -->
                                                                    <Border BorderThickness="1"
                                                                            BorderBrush="{StaticResource BorderBrush}"
                                                                            CornerRadius="5"
                                                                            Visibility="{Binding IsTable,
                                                                              Converter={StaticResource BoolToVis}}">
                                                                        <ItemsControl ItemsSource="{Binding Rows}">
                                                                            <ItemsControl.ItemTemplate>
                                                                                <DataTemplate>
                                                                                    <Border BorderThickness="0,0,0,1"
                                                                                            BorderBrush="{StaticResource BorderBrush}"
                                                                                            Padding="10,6">
                                                                                        <ItemsControl ItemsSource="{Binding}">
                                                                                            <ItemsControl.ItemsPanel>
                                                                                                <ItemsPanelTemplate>
                                                                                                    <StackPanel Orientation="Horizontal" />
                                                                                                </ItemsPanelTemplate>
                                                                                            </ItemsControl.ItemsPanel>
                                                                                            <ItemsControl.ItemTemplate>
                                                                                                <DataTemplate>
                                                                                                    <TextBlock Text="{Binding}"
                                                                                                               FontSize="12"
                                                                                                               MinWidth="90"
                                                                                                               Margin="0,0,12,0"
                                                                                                               TextWrapping="Wrap" />
                                                                                                </DataTemplate>
                                                                                            </ItemsControl.ItemTemplate>
                                                                                        </ItemsControl>
                                                                                    </Border>
                                                                                </DataTemplate>
                                                                            </ItemsControl.ItemTemplate>
                                                                        </ItemsControl>
                                                                    </Border>

                                                                    <!-- 分隔线 -->
                                                                    <Border Height="1"
                                                                            Background="{StaticResource BorderBrush}"
                                                                            Visibility="{Binding IsRule,
                                                                              Converter={StaticResource BoolToVis}}" />
                                                                </Grid>
                                                            </DataTemplate>
                                                        </ItemsControl.ItemTemplate>
                                                    </ItemsControl>
                                                </ScrollViewer>
                                            </StackPanel>
                                        </Border>

                                        <TextBlock Text="{Binding ParsedTitle}" FontSize="14.5"
                                                   FontWeight="SemiBold" TextWrapping="Wrap"
                                                   Margin="0,10,0,0" />
                                        <TextBlock Text="{Binding ParsedNote}"
                                                   Style="{StaticResource MutedText}"
                                                   TextWrapping="Wrap" Margin="0,5,0,0" />

                                        <StackPanel Margin="0,14,0,0"
                                                    Visibility="{Binding ShowAssets,
                                                      Converter={StaticResource BoolToVis}}">
                                            <Grid Margin="0,0,0,8">
                                                <Grid.ColumnDefinitions>
                                                    <ColumnDefinition Width="*" />
                                                    <ColumnDefinition Width="Auto" />
                                                </Grid.ColumnDefinitions>
                                                <StackPanel Grid.Column="0" VerticalAlignment="Center">
                                                    <TextBlock Text="{Binding AssetsTitle}"
                                                               Style="{StaticResource SectionTitle}"
                                                               HorizontalAlignment="Left" />
                                                    <TextBlock Text="{Binding CloudPathText}"
                                                               Style="{StaticResource CaptionText}"
                                                               TextTrimming="CharacterEllipsis"
                                                               MaxWidth="380" Margin="0,3,0,0"
                                                               HorizontalAlignment="Left"
                                                               Visibility="{Binding IsCloudSource,
                                                                 Converter={StaticResource BoolToVis}}" />
                                                </StackPanel>
                                                <StackPanel Grid.Column="1" Orientation="Horizontal"
                                                            VerticalAlignment="Center">
                                                    <Button Style="{StaticResource SmallButton}"
                                                            Command="{Binding CloudBackCommand}"
                                                            Margin="0,0,4,0"
                                                            Visibility="{Binding CanCloudBack,
                                                              Converter={StaticResource BoolToVis}}">
                                                        <TextBlock Text="‹ 上级"
                                                                   Foreground="{DynamicResource AccentBrush}" />
                                                    </Button>
                                                    <Button Style="{StaticResource SmallButton}"
                                                            Command="{Binding SelectAllAssetsCommand}"
                                                            Margin="4,0,0,0"
                                                            Content="全选" />
                                                    <Button Style="{StaticResource SmallButton}"
                                                            Command="{Binding SelectNoAssetsCommand}"
                                                            Margin="4,0,0,0"
                                                            Content="清空" />
                                                </StackPanel>
                                            </Grid>
                                            <Border Style="{StaticResource CardFlat}" MaxHeight="240">
                                                <ScrollViewer Style="{StaticResource SlimScrollViewer}"
                                                              VerticalScrollBarVisibility="Auto"
                                                              Margin="0,6">
                                                    <ItemsControl ItemsSource="{Binding Assets}">
                                                        <ItemsControl.ItemTemplate>
                                                            <DataTemplate>
                                                                <Grid>
                                                                    <!-- 文件：可勾选 -->
                                                                    <CheckBox Style="{StaticResource FlatCheck}"
                                                                              IsChecked="{Binding IsSelected}"
                                                                              Margin="12,5" FontSize="12"
                                                                              Visibility="{Binding IsFile,
                                                                                Converter={StaticResource BoolToVis}}">
                                                                        <Grid MinWidth="380">
                                                                            <TextBlock Text="{Binding Name}"
                                                                                       FontSize="12"
                                                                                       TextTrimming="CharacterEllipsis"
                                                                                       MaxWidth="420" />
                                                                            <TextBlock Text="{Binding SizeText}"
                                                                                       FontSize="11"
                                                                                       HorizontalAlignment="Right"
                                                                                       Foreground="{StaticResource TextDimBrush}" />
                                                                        </Grid>
                                                                    </CheckBox>

                                                                    <!--
                                                                        目录：不可勾选，点进去。
                                                                        用 Button 而不是「CheckBox + 双击」：
                                                                        下载器里双击是很不明显的交互，用户不会去试。
                                                                    -->
                                                                    <Button Style="{StaticResource IconButton}"
                                                                            Height="30" Padding="12,0"
                                                                            HorizontalContentAlignment="Stretch"
                                                                            Command="{Binding DataContext.EnterCloudDirCommand,
                                                                              RelativeSource={RelativeSource AncestorType=Window}}"
                                                                            CommandParameter="{Binding}"
                                                                            ToolTip="进入这个目录"
                                                                            Visibility="{Binding IsDirectory,
                                                                              Converter={StaticResource BoolToVis}}">
                                                                        <Grid MinWidth="380">
                                                                            <StackPanel Orientation="Horizontal"
                                                                                        VerticalAlignment="Center">
                                                                                <Path Data="{StaticResource IconFolder}"
                                                                                      Width="13" Height="13"
                                                                                      Stretch="Uniform"
                                                                                      VerticalAlignment="Center"
                                                                                      Fill="{DynamicResource AccentBrush}" />
                                                                                <TextBlock Text="{Binding Name}"
                                                                                           FontSize="12"
                                                                                           Margin="7,0,0,0"
                                                                                           VerticalAlignment="Center"
                                                                                           TextTrimming="CharacterEllipsis"
                                                                                           MaxWidth="360"
                                                                                           Foreground="{DynamicResource AccentBrush}" />
                                                                            </StackPanel>
                                                                            <TextBlock Text="进入 ›"
                                                                                       FontSize="11"
                                                                                       HorizontalAlignment="Right"
                                                                                       VerticalAlignment="Center"
                                                                                       Foreground="{StaticResource TextDimBrush}" />
                                                                        </Grid>
                                                                    </Button>
                                                                </Grid>
                                                            </DataTemplate>
                                                        </ItemsControl.ItemTemplate>
                                                    </ItemsControl>
                                                </ScrollViewer>
                                            </Border>

                                            <!-- 分页：网盘目录一页 100~200 条，只有首页时后面的文件永远看不到 -->
                                            <Button Style="{StaticResource GhostButton}"
                                                    Content="加载更多…" FontSize="11.5" Padding="12,5"
                                                    HorizontalAlignment="Center"
                                                    Margin="0,8,0,0"
                                                    Command="{Binding LoadMoreCommand}"
                                                    Visibility="{Binding CanLoadMore,
                                                      Converter={StaticResource BoolToVis}}" />

                                            <!--
                                                列表底部再放一个「开始下载」。
                                                原因：文件列表最多 240px、可滚动，但页面本身也长 ——
                                                用户勾完选在列表底部，顶部那个「开始下载」已经滚出视野，
                                                得手动滑回顶部才能开下。这里给一个"就地可用"的入口。
                                                与顶部按钮绑同一个命令，行为完全一致。
                                            -->
                                            <Grid Margin="0,12,0,0">
                                                <Grid.ColumnDefinitions>
                                                    <ColumnDefinition Width="*" />
                                                    <ColumnDefinition Width="Auto" />
                                                </Grid.ColumnDefinitions>

                                                <TextBlock Grid.Column="0" VerticalAlignment="Center"
                                                           Style="{StaticResource CaptionText}"
                                                           Text="{Binding AssetsSelectionText}" />

                                                <StackPanel Grid.Column="1" Orientation="Horizontal">
                                                    <Button Style="{StaticResource GhostButton}"
                                                            Content="回到顶部" FontSize="11.5" Padding="12,5"
                                                            Command="{Binding ScrollParseToTopCommand}" />
                                                    <Button Style="{StaticResource PrimaryButton}"
                                                            Command="{Binding DownloadCommand}"
                                                            Content="开始下载" FontSize="12"
                                                            Padding="18,7" Margin="8,0,0,0" />
                                                </StackPanel>
                                            </Grid>
                                        </StackPanel>
                                    </StackPanel>
                                </Border>

                                <!--
                                    解析历史。
                                    之前这套功能是"只写不读"：History 集合、搜索、复用、删除都有，
                                    库也在写，但界面上一处绑定都没有 —— 用户完全看不到。
                                    放在解析页（而不是单独开一页）是因为它的用途就是"把上次的链接再拿来用"。
                                -->
                                <Border Style="{StaticResource Card}" Padding="18" Margin="0,20,0,0">
                                    <StackPanel>
                                        <Grid>
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="*" />
                                                <ColumnDefinition Width="Auto" />
                                            </Grid.ColumnDefinitions>
                                            <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                                <TextBlock Text="解析历史" FontSize="13" FontWeight="Medium" />
                                                <TextBlock Text="{Binding History.Count, StringFormat={}({0})}"
                                                           Style="{StaticResource CaptionText}"
                                                           Margin="6,0,0,0" VerticalAlignment="Center" />
                                                <TextBlock Text="· 点一行即可载入（提取码一并带上）"
                                                           Style="{StaticResource CaptionText}"
                                                           Margin="8,0,0,0" VerticalAlignment="Center" />
                                            </StackPanel>
                                            <Button Grid.Column="1" Style="{StaticResource CaptionButton}"
                                                    Content="清空" VerticalAlignment="Center"
                                                    Command="{Binding ClearHistoryCommand}"
                                                    Visibility="{Binding HasHistory, Converter={StaticResource BoolToVis}}" />
                                        </Grid>

                                        <!-- 搜索：历史多了以后必须能筛 -->
                                        <TextBox Height="34" Margin="0,12,0,0"
                                                 Text="{Binding HistoryKeyword, UpdateSourceTrigger=PropertyChanged}"
                                                 Visibility="{Binding HasHistory, Converter={StaticResource BoolToVis}}">
                                            <TextBox.Resources>
                                                <VisualBrush x:Key="Hint" x:Shared="False" AlignmentX="Left"
                                                             Stretch="None">
                                                    <VisualBrush.Visual>
                                                        <TextBlock Text="搜索标题或链接…" Margin="13,0,0,0"
                                                                   Foreground="{StaticResource TextDimBrush}"
                                                                   FontSize="12" />
                                                    </VisualBrush.Visual>
                                                </VisualBrush>
                                            </TextBox.Resources>
                                            <TextBox.Style>
                                                <Style TargetType="TextBox" BasedOn="{StaticResource InputBox}">
                                                    <Style.Triggers>
                                                        <Trigger Property="Text" Value="">
                                                            <Setter Property="Background"
                                                                    Value="{StaticResource Hint}" />
                                                        </Trigger>
                                                    </Style.Triggers>
                                                </Style>
                                            </TextBox.Style>
                                        </TextBox>

                                        <!-- 列表 -->
                                        <ItemsControl ItemsSource="{Binding History}" Margin="0,10,0,0"
                                                      MaxHeight="260"
                                                      Visibility="{Binding HasHistory, Converter={StaticResource BoolToVis}}">
                                            <ItemsControl.Template>
                                                <ControlTemplate TargetType="ItemsControl">
                                                    <ScrollViewer Style="{StaticResource SlimScrollViewer}"
                                                                  VerticalScrollBarVisibility="Auto">
                                                        <ItemsPresenter />
                                                    </ScrollViewer>
                                                </ControlTemplate>
                                            </ItemsControl.Template>
                                            <ItemsControl.ItemTemplate>
                                                <DataTemplate>
                                                    <Border Background="Transparent" CornerRadius="5"
                                                            Padding="8,7" Margin="0,1">
                                                        <Grid>
                                                            <Grid.ColumnDefinitions>
                                                                <ColumnDefinition Width="Auto" />
                                                                <ColumnDefinition Width="*" />
                                                                <ColumnDefinition Width="Auto" />
                                                            </Grid.ColumnDefinitions>

                                                            <Border Grid.Column="0" Style="{StaticResource Badge}"
                                                                    VerticalAlignment="Center" Margin="0,0,9,0">
                                                                <TextBlock Text="{Binding Kind}" FontSize="10" />
                                                            </Border>

                                                            <StackPanel Grid.Column="1" VerticalAlignment="Center">
                                                                <TextBlock Text="{Binding Title}" FontSize="12.5"
                                                                           TextTrimming="CharacterEllipsis" />
                                                                <TextBlock FontSize="10.5" Margin="0,2,0,0"
                                                                           TextTrimming="CharacterEllipsis"
                                                                           Foreground="{StaticResource TextDimBrush}">
                                                                    <Run Text="{Binding RawInput, Mode=OneWay}" />
                                                                    <Run Text=" · " />
                                                                    <Run Text="{Binding CreatedAt, StringFormat={}{0:MM-dd HH:mm}, Mode=OneWay}" />
                                                                </TextBlock>
                                                            </StackPanel>

                                                            <StackPanel Grid.Column="2" Orientation="Horizontal"
                                                                        VerticalAlignment="Center">
                                                                <!-- 载入：整个行都可以点，这里其实只是视觉提示 -->
                                                                <Button Style="{StaticResource CaptionButton}"
                                                                        Content="载入"
                                                                        Command="{Binding DataContext.UseHistoryCommand,
                                                                                  RelativeSource={RelativeSource AncestorType=ItemsControl}}"
                                                                        CommandParameter="{Binding}" />
                                                                <Button Style="{StaticResource CaptionButton}"
                                                                        Content="删除" Margin="6,0,0,0"
                                                                        Command="{Binding DataContext.DeleteHistoryCommand,
                                                                                  RelativeSource={RelativeSource AncestorType=ItemsControl}}"
                                                                        CommandParameter="{Binding}" />
                                                            </StackPanel>
                                                        </Grid>
                                                    </Border>
                                                </DataTemplate>
                                            </ItemsControl.ItemTemplate>
                                        </ItemsControl>

                                        <!-- 空态 -->
                                        <TextBlock Text="{Binding HistoryEmptyText}"
                                                   Style="{StaticResource CaptionText}"
                                                   TextWrapping="Wrap" LineHeight="19" Margin="0,10,0,0"
                                                   Visibility="{Binding HasHistory,
                                                     Converter={StaticResource InverseBoolToVis}}" />
                                    </StackPanel>
                                </Border>

                                <StackPanel Margin="0,24,0,0"
                                            Visibility="{Binding HasParsed,
                                              Converter={StaticResource InverseBoolToVis}}">
                                    <TextBlock Text="GitHub"
                                               Style="{StaticResource SectionTitle}" />
                                    <TextBlock Style="{StaticResource CaptionText}"
                                               TextWrapping="Wrap" Margin="0,8,0,0"
                                               LineHeight="21">
                                        仓库 · 单文件(blob) · 目录(tree) · Release 页面 · 指定 tag ·
                                        资产直链 · 归档链接 · Gist · owner/repo 简写
                                    </TextBlock>

                                    <TextBlock Text="网盘分享"
                                               Style="{StaticResource SectionTitle}"
                                               Margin="0,16,0,0" />
                                    <TextBlock Style="{StaticResource CaptionText}"
                                               TextWrapping="Wrap" Margin="0,8,0,0"
                                               LineHeight="21">
                                        夸克 · UC · 百度 · 迅雷 · 139 · 123 · 蓝奏 · 115 · 光鸭
                                    </TextBlock>
                                    <TextBlock Style="{StaticResource CaptionText}"
                                               TextWrapping="Wrap" Margin="0,6,0,0"
                                               LineHeight="21"
                                               Foreground="{StaticResource TextDimBrush}">
                                        提取码可以直接写在链接后面（「提取码：xxxx」），也可以把整段分享文本一起粘进来；
                                        中文口令也能识别。需要登录的平台请先去「账号」页授权。
                                    </TextBlock>
                                </StackPanel>
                            </StackPanel>
                        </ScrollViewer>
                    </Grid>

                    <!-- ========== 下载页 ========== -->
                    <Grid Visibility="{Binding IsDownloadsPage, Converter={StaticResource BoolToVis}}">
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="*" />
                            <RowDefinition Height="Auto" />
                        </Grid.RowDefinitions>

                        <Grid Margin="34,24,34,0">
                            <!--
                                用两列而不是「左侧 StackPanel + 右侧右对齐」叠在同一个格里：
                                叠放时标题过长会直接压到按钮上（PageTitle 没有 Trim），
                                而分成两列后左侧会被限制在自己的列内。
                            -->
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>
                            <StackPanel Grid.Column="0">
                                <TextBlock Text="下载任务" Style="{StaticResource PageTitle}" />
                                <TextBlock Text="{Binding StatusText}"
                                           Style="{StaticResource MutedText}" Margin="0,7,0,0" />
                            </StackPanel>
                            <StackPanel Grid.Column="1" Orientation="Horizontal"
                                        VerticalAlignment="Top" Margin="16,0,0,0">
                                <Button Style="{StaticResource GhostButton}"
                                        Command="{Binding CancelAllCommand}"
                                        Content="全部取消" FontSize="12" />
                                <Button Style="{StaticResource GhostButton}"
                                        Command="{Binding ClearFinishedCommand}"
                                        Content="清空已完成" FontSize="12" Margin="8,0,0,0" />
                            </StackPanel>
                        </Grid>

                        <Grid Grid.Row="1" Margin="34,16,34,0">
                            <StackPanel VerticalAlignment="Center" HorizontalAlignment="Center"
                                        Visibility="{Binding HasTasks,
                                          Converter={StaticResource InverseBoolToVis}}">
                                <Border Width="54" Height="54" CornerRadius="16"
                                        Background="{StaticResource SurfaceHiBrush}"
                                        HorizontalAlignment="Center">
                                    <Path Data="{StaticResource IconDownload}" Width="24" Height="24"
                                          Stretch="Uniform" Fill="{StaticResource TextDimBrush}"
                                          HorizontalAlignment="Center"
                                          VerticalAlignment="Center" />
                                </Border>
                                <TextBlock Text="还没有下载任务" FontSize="13.5"
                                           Foreground="{StaticResource TextMutedBrush}"
                                           HorizontalAlignment="Center" Margin="0,14,0,0" />
                                <TextBlock Text="到「解析」页粘贴一个链接开始"
                                           Style="{StaticResource CaptionText}"
                                           HorizontalAlignment="Center" Margin="0,6,0,0" />
                                <Button Style="{StaticResource GhostButton}"
                                        Command="{Binding NavigateCommand}"
                                        CommandParameter="parse"
                                        Content="去解析" Margin="0,16,0,0"
                                        HorizontalAlignment="Center" FontSize="12" />
                            </StackPanel>

                            <ScrollViewer Style="{StaticResource SlimScrollViewer}"
                                          VerticalScrollBarVisibility="Auto"
                                          Visibility="{Binding HasTasks,
                                            Converter={StaticResource BoolToVis}}">
                                <ItemsControl ItemsSource="{Binding Tasks}" Margin="0,0,4,10">
                                    <ItemsControl.ItemTemplate>
                                        <DataTemplate>
                                            <Border Style="{StaticResource Card}"
                                                    Padding="16,13" Margin="0,0,0,8">
                                                <Grid>
                                                    <Grid.RowDefinitions>
                                                        <RowDefinition Height="Auto" />
                                                        <RowDefinition Height="Auto" />
                                                        <RowDefinition Height="Auto" />
                                                    </Grid.RowDefinitions>

                                                    <Grid>
                                                        <Grid.ColumnDefinitions>
                                                            <ColumnDefinition Width="Auto" />
                                                            <ColumnDefinition Width="*" />
                                                            <ColumnDefinition Width="Auto" />
                                                        </Grid.ColumnDefinitions>

                                                        <Border Width="28" Height="28" CornerRadius="8"
                                                                Background="{StaticResource SurfaceHiBrush}">
                                                            <Path Width="14" Height="14"
                                                                  Stretch="Uniform"
                                                                  HorizontalAlignment="Center"
                                                                  VerticalAlignment="Center"
                                                                  Fill="{Binding State, Converter={StaticResource StateToBrush}}"
                                                                  Data="{Binding State, Converter={StaticResource StateToGeo}}" />
                                                        </Border>

                                                        <TextBlock Grid.Column="1" Text="{Binding FileName}"
                                                                   FontSize="13" FontWeight="Medium"
                                                                   TextTrimming="CharacterEllipsis"
                                                                   VerticalAlignment="Center"
                                                                   Margin="11,0,10,0" />

                                                        <StackPanel Grid.Column="2" Orientation="Horizontal">
                                                            <!-- 暂停（运行中） -->
                                                            <Button Style="{StaticResource SmallButton}"
                                                                    Margin="6,0,0,0"
                                                                    Command="{Binding DataContext.PauseTaskCommand,
                                                                      RelativeSource={RelativeSource AncestorType=Window}}"
                                                                    CommandParameter="{Binding}"
                                                                    Visibility="{Binding CanPause,
                                                                      Converter={StaticResource BoolToVis}}">
                                                                <TextBlock Text="暂停" FontSize="11" />
                                                            </Button>
                                                            <!-- 继续（暂停/失败） -->
                                                            <Button Style="{StaticResource SmallButton}"
                                                                    Margin="6,0,0,0"
                                                                    Command="{Binding DataContext.ResumeTaskCommand,
                                                                      RelativeSource={RelativeSource AncestorType=Window}}"
                                                                    CommandParameter="{Binding}"
                                                                    Visibility="{Binding CanResume,
                                                                      Converter={StaticResource BoolToVis}}">
                                                                <TextBlock Text="继续" FontSize="11"
                                                                           Foreground="{DynamicResource AccentBrush}" />
                                                            </Button>
                                                            <!-- 打开文件 -->
                                                            <Button Style="{StaticResource SmallButton}"
                                                                    Margin="6,0,0,0"
                                                                    Command="{Binding DataContext.OpenFileCommand,
                                                                      RelativeSource={RelativeSource AncestorType=Window}}"
                                                                    CommandParameter="{Binding}"
                                                                    Visibility="{Binding HasResult,
                                                                      Converter={StaticResource BoolToVis}}">
                                                                <TextBlock Text="打开" FontSize="11" />
                                                            </Button>
                                                            <!-- 在资源管理器中显示（选中文件） -->
                                                            <Button Style="{StaticResource SmallButton}"
                                                                    Margin="6,0,0,0"
                                                                    Command="{Binding DataContext.RevealFileCommand,
                                                                      RelativeSource={RelativeSource AncestorType=Window}}"
                                                                    CommandParameter="{Binding}"
                                                                    Visibility="{Binding HasResult,
                                                                      Converter={StaticResource BoolToVis}}">
                                                                <TextBlock Text="定位" FontSize="11" />
                                                            </Button>
                                                            <!-- 删除 -->
                                                            <Button Style="{StaticResource SmallButton}"
                                                                    Margin="6,0,0,0"
                                                                    Command="{Binding DataContext.DeleteTaskCommand,
                                                                      RelativeSource={RelativeSource AncestorType=Window}}"
                                                                    CommandParameter="{Binding}">
                                                                <TextBlock Text="删除" FontSize="11" />
                                                            </Button>
                                                        </StackPanel>
                                                    </Grid>

                                                    <Grid Grid.Row="1" Height="6" Margin="39,11,0,0"
                                                          x:Name="BarHost">
                                                        <Border Background="{StaticResource SurfaceTopBrush}"
                                                                CornerRadius="3" />
                                                        <Border HorizontalAlignment="Left" CornerRadius="3"
                                                                Background="{Binding State,
                                                                  Converter={StaticResource StateToBrush}}">
                                                            <Border.Width>
                                                                <MultiBinding Converter="{StaticResource PercentToWidth}">
                                                                    <Binding Path="Percent" />
                                                                    <Binding Path="ActualWidth"
                                                                             ElementName="BarHost" />
                                                                </MultiBinding>
                                                            </Border.Width>
                                                        </Border>
                                                    </Grid>

                                                    <Grid Grid.Row="2" Margin="39,8,0,0">
                                                        <StackPanel Orientation="Horizontal">
                                                            <TextBlock Text="{Binding StateText}"
                                                                       FontSize="11.5"
                                                                       Foreground="{Binding State,
                                                                         Converter={StaticResource StateToBrush}}" />
                                                            <TextBlock Text="{Binding ProgressText}"
                                                                       FontSize="11.5"
                                                                       Foreground="{StaticResource TextDimBrush}"
                                                                       Margin="12,0,0,0" />
                                                            <TextBlock Text="{Binding Error}"
                                                                       FontSize="11.5"
                                                                       Foreground="{StaticResource ErrBrush}"
                                                                       Margin="12,0,0,0"
                                                                       TextTrimming="CharacterEllipsis"
                                                                       MaxWidth="320"
                                                                       Visibility="{Binding Error,
                                                                         Converter={StaticResource NotEmptyToVis}}" />
                                                        </StackPanel>
                                                        <StackPanel Orientation="Horizontal"
                                                                    HorizontalAlignment="Right">
                                                            <TextBlock Text="{Binding SpeedText}"
                                                                       FontSize="11.5"
                                                                       Foreground="{StaticResource TextMutedBrush}" />
                                                            <TextBlock Text="{Binding EtaText}"
                                                                       FontSize="11.5"
                                                                       Foreground="{StaticResource TextDimBrush}"
                                                                       Margin="12,0,0,0" />
                                                        </StackPanel>
                                                    </Grid>
                                                </Grid>
                                            </Border>
                                        </DataTemplate>
                                    </ItemsControl.ItemTemplate>
                                </ItemsControl>
                            </ScrollViewer>
                        </Grid>

                        <Border Grid.Row="2" Margin="34,0,34,14"
                                Background="{StaticResource SurfaceBrush}"
                                BorderBrush="{StaticResource BorderBrush}"
                                BorderThickness="1" CornerRadius="10">
                            <StackPanel>
                                <Button Style="{StaticResource IconButton}"
                                        Width="Auto" Height="34"
                                        HorizontalContentAlignment="Stretch"
                                        Command="{Binding ToggleLogCommand}"
                                        Margin="8,4">
                                    <Grid>
                                        <TextBlock Text="运行日志" FontSize="11.5"
                                                   VerticalAlignment="Center" Margin="6,0"
                                                   Foreground="{StaticResource TextMutedBrush}" />
                                        <Path x:Name="LogChevron"
                                              Data="{StaticResource IconChevronDown}"
                                              Width="14" Height="14" Stretch="Uniform"
                                              HorizontalAlignment="Right" Margin="0,0,8,0"
                                              Fill="{StaticResource TextDimBrush}"
                                              VerticalAlignment="Center"
                                              RenderTransformOrigin="0.5,0.5">
                                            <Path.RenderTransform>
                                                <RotateTransform Angle="0" />
                                            </Path.RenderTransform>
                                        </Path>
                                    </Grid>
                                </Button>

                                <ScrollViewer Style="{StaticResource SlimScrollViewer}"
                                              Height="150" Margin="14,0,8,10"
                                              VerticalScrollBarVisibility="Auto"
                                              Visibility="{Binding ShowLog,
                                                Converter={StaticResource BoolToVis}}">
                                    <ItemsControl ItemsSource="{Binding LogLines}">
                                        <ItemsControl.ItemTemplate>
                                            <DataTemplate>
                                                <TextBlock Text="{Binding}"
                                                           FontFamily="{StaticResource MonoFont}"
                                                           FontSize="11"
                                                           Foreground="{StaticResource TextDimBrush}"
                                                           TextWrapping="Wrap" Margin="0,1" />
                                            </DataTemplate>
                                        </ItemsControl.ItemTemplate>
                                    </ItemsControl>
                                </ScrollViewer>
                            </StackPanel>
                        </Border>
                    </Grid>


                    <!-- ========== 账号页 ========== -->
                    <Grid Visibility="{Binding IsAccountsPage, Converter={StaticResource BoolToVis}}">
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="*" />
                        </Grid.RowDefinitions>

                        <Grid Margin="34,24,34,0">
                            <StackPanel>
                                <TextBlock Text="网盘账号" Style="{StaticResource PageTitle}" />
                                <TextBlock Text="{Binding CloudStatus}"
                                           Style="{StaticResource MutedText}" Margin="0,7,0,0" />
                            </StackPanel>
                        </Grid>

                        <ScrollViewer Grid.Row="1" Style="{StaticResource SlimScrollViewer}"
                                      VerticalScrollBarVisibility="Auto" Margin="0,16,0,0">
                            <StackPanel Margin="34,0,34,26" MaxWidth="760"
                                        HorizontalAlignment="Center" Width="760">

                                <Border Style="{StaticResource Card}" Padding="18">
                                    <ItemsControl ItemsSource="{Binding CloudAccounts}">
                                        <ItemsControl.ItemTemplate>
                                            <DataTemplate>
                                                <Grid Margin="0,7">
                                                    <Grid.ColumnDefinitions>
                                                        <ColumnDefinition Width="Auto" />
                                                        <ColumnDefinition Width="*" />
                                                        <ColumnDefinition Width="Auto" />
                                                        <ColumnDefinition Width="Auto" />
                                                        <ColumnDefinition Width="Auto" />
                                                    </Grid.ColumnDefinitions>

                                                    <Border Width="32" Height="32" CornerRadius="9"
                                                            Background="{StaticResource SurfaceHiBrush}">
                                                        <Path Data="{StaticResource IconGlobe}" Width="16" Height="16"
                                                              Stretch="Uniform"
                                                              HorizontalAlignment="Center"
                                                              VerticalAlignment="Center"
                                                              Fill="{StaticResource TextMutedBrush}" />
                                                    </Border>

                                                    <StackPanel Grid.Column="1" Margin="12,0,0,0"
                                                                VerticalAlignment="Center">
                                                        <TextBlock Text="{Binding DisplayName}" FontSize="13"
                                                                   FontWeight="Medium" />
                                                        <TextBlock Text="{Binding LoginHint}"
                                                                   Style="{StaticResource CaptionText}"
                                                                   TextWrapping="Wrap" Margin="0,3,0,0" />
                                                    </StackPanel>

                                                    <Border Grid.Column="2" Style="{StaticResource Badge}"
                                                            Margin="0,0,10,0">
                                                        <TextBlock Text="{Binding Status}" FontSize="10.5"
                                                                   Foreground="{StaticResource TextMutedBrush}" />
                                                    </Border>

                                                    <Button Grid.Column="3" Style="{StaticResource GhostButton}"
                                                            Content="登录 / 更新" FontSize="11.5" Padding="10,4"
                                                            Command="{Binding DataContext.CloudLoginCommand,
                                                              RelativeSource={RelativeSource AncestorType=Window}}"
                                                            CommandParameter="{Binding}" />
                                                    <!-- 登出：清除该平台保存的 Cookie/凭证。
                                                         之前只有登录入口、没有登出，用户换账号只能手删数据目录。 -->
                                                    <Button Grid.Column="4" Style="{StaticResource GhostButton}"
                                                            Content="登出" FontSize="11.5" Padding="10,4"
                                                            Margin="6,0,0,0"
                                                            Command="{Binding DataContext.CloudLogoutCommand,
                                                              RelativeSource={RelativeSource AncestorType=Window}}"
                                                            CommandParameter="{Binding}"
                                                            Visibility="{Binding IsLoggedIn,
                                                              Converter={StaticResource BoolToVis}}" />
                                                </Grid>
                                            </DataTemplate>
                                        </ItemsControl.ItemTemplate>
                                    </ItemsControl>
                                </Border>

                                <Border Style="{StaticResource Card}" Padding="18" Margin="0,14,0,0">
                                    <StackPanel>
                                        <TextBlock Text="认证备份" FontSize="13" FontWeight="Medium" />
                                        <TextBlock Text="用口令派生的密钥（PBKDF2 + AES-GCM）加密全部凭证，导出 .yunx 文件后可跨设备恢复"
                                                   Style="{StaticResource CaptionText}"
                                                   TextWrapping="Wrap" Margin="0,4,0,10" />
                                        <StackPanel Orientation="Horizontal">
                                            <Button Style="{StaticResource GhostButton}"
                                                    Content="导出备份" FontSize="12"
                                                    Command="{Binding ExportBackupCommand}" />
                                            <Button Style="{StaticResource GhostButton}"
                                                    Content="导入备份" FontSize="12" Margin="8,0,0,0"
                                                    Command="{Binding ImportBackupCommand}" />
                                        </StackPanel>
                                    </StackPanel>
                                </Border>

                                <Border Style="{StaticResource Card}" Padding="18" Margin="0,14,0,0">
                                    <StackPanel>
                                        <TextBlock Text="凭证保护等级" FontSize="13" FontWeight="Medium" />
                                        <TextBlock Text="三档都只重新包裹 32 字节主密钥，不变动已加密数据"
                                                   Style="{StaticResource CaptionText}"
                                                   TextWrapping="Wrap" Margin="0,4,0,8" />
                                        <ComboBox ItemsSource="{Binding KeyProtectionLabels}"
                                                  SelectedItem="{Binding KeyProtectionLabel}"
                                                  FontFamily="Microsoft YaHei UI" FontSize="12" />
                                        <!--
                                            这句原来写的是「改成宽松后 .yunx 备份与数据库才能带到别的电脑」——
                                            错的，会误导用户去降低安全性。
                                            实际情况：.yunx 用**用户口令**派生的密钥加密，与机器无关；
                                            只要在**原机器**上导出（那时主密钥还能解开），
                                            就能在任意新机器上导入恢复。保护档不需要动。
                                        -->
                                        <TextBlock Text="换电脑不需要改这一档：在原机器用上面的「导出备份」生成 .yunx（口令加密，与机器无关），到新机器「导入备份」即可。这里三档只影响本机 credential.key 的保护强度 —— 默认「普通」下，即使整个数据目录被拷走，凭证也解不开。"
                                                   Style="{StaticResource CaptionText}"
                                                   TextWrapping="Wrap" LineHeight="18"
                                                   Margin="0,8,0,0" />
                                    </StackPanel>
                                </Border>
                            </StackPanel>
                        </ScrollViewer>
                    </Grid>


                    <!-- ========== 调试页 ========== -->
                    <Grid Visibility="{Binding IsDebugPage, Converter={StaticResource BoolToVis}}">
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="*" />
                        </Grid.RowDefinitions>

                        <Grid Margin="34,24,34,0">
                            <StackPanel>
                                <TextBlock Text="下载调试" Style="{StaticResource PageTitle}" />
                                <TextBlock Style="{StaticResource MutedText}" Margin="0,7,0,0"
                                           Text="按任务查看引擎事件时序（测速 → 分片规划 → 换连接 → 完成）与运行时资源占用" />
                            </StackPanel>
                        </Grid>

                        <Grid Grid.Row="1" Margin="34,16,34,20">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="260" />
                                <ColumnDefinition Width="*" />
                            </Grid.ColumnDefinitions>

                            <!-- 左：任务列表 -->
                            <Border Style="{StaticResource Card}" Padding="10">
                                <Grid>
                                    <Grid.RowDefinitions>
                                        <RowDefinition Height="Auto" />
                                        <RowDefinition Height="*" />
                                    </Grid.RowDefinitions>
                                    <TextBlock Text="任务" Style="{StaticResource SectionTitle}"
                                               Margin="4,2,0,8" />
                                    <ListBox Grid.Row="1" ItemsSource="{Binding Tasks}"
                                             SelectedItem="{Binding DebugTask}"
                                             Background="Transparent" BorderThickness="0"
                                             Foreground="{DynamicResource TextBrush}"
                                             FontFamily="Microsoft YaHei UI" FontSize="12">
                                        <ListBox.ItemTemplate>
                                            <DataTemplate>
                                                <StackPanel Margin="2,5">
                                                    <TextBlock Text="{Binding FileName}" FontSize="12"
                                                               TextTrimming="CharacterEllipsis" />
                                                    <TextBlock Style="{StaticResource CaptionText}"
                                                               Margin="0,2,0,0">
                                                        <Run Text="#" /><Run Text="{Binding TaskId, Mode=OneWay}" />
                                                        <Run Text=" · " /><Run Text="{Binding StateText, Mode=OneWay}" />
                                                    </TextBlock>
                                                </StackPanel>
                                            </DataTemplate>
                                        </ListBox.ItemTemplate>
                                    </ListBox>
                                </Grid>
                            </Border>

                            <!-- 右：事件流 + 资源快照 -->
                            <Grid Grid.Column="1" Margin="14,0,0,0">
                                <Grid.RowDefinitions>
                                    <RowDefinition Height="Auto" />
                                    <RowDefinition Height="*" />
                                    <RowDefinition Height="Auto" />
                                </Grid.RowDefinitions>

                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="Auto" />
                                    </Grid.ColumnDefinitions>
                                    <StackPanel Grid.Column="0" VerticalAlignment="Center">
                                        <TextBlock Text="{Binding DebugTaskTitle}"
                                                   FontSize="13" FontWeight="Medium"
                                                   HorizontalAlignment="Left" />
                                        <TextBlock Style="{StaticResource CaptionText}" Margin="0,4,0,0"
                                                   HorizontalAlignment="Left"
                                                   Text="事件流只在「设置 → 诊断与日志 → 下载调试」开启时记录" />
                                    </StackPanel>
                                    <StackPanel Grid.Column="1" Orientation="Horizontal"
                                                VerticalAlignment="Center">
                                        <Button Style="{StaticResource GhostButton}" Content="刷新"
                                                FontSize="11.5" Padding="10,4"
                                                Command="{Binding RefreshDebugCommand}" />
                                        <Button Style="{StaticResource GhostButton}" Content="清空"
                                                FontSize="11.5" Padding="10,4" Margin="6,0,0,0"
                                                Command="{Binding ClearDebugCommand}" />
                                    </StackPanel>
                                </Grid>

                                <Border Grid.Row="1" Style="{StaticResource Card}" Margin="0,10,0,0"
                                        Padding="0">
                                    <ScrollViewer Style="{StaticResource SlimScrollViewer}"
                                                  VerticalScrollBarVisibility="Auto"
                                                  Padding="12,10">
                                        <ItemsControl ItemsSource="{Binding DebugEvents}">
                                            <ItemsControl.ItemTemplate>
                                                <DataTemplate>
                                                    <TextBlock Text="{Binding}" FontSize="11.5"
                                                               FontFamily="Consolas, Microsoft YaHei UI"
                                                               Foreground="{DynamicResource TextMutedBrush}"
                                                               TextWrapping="Wrap" Margin="0,1" />
                                                </DataTemplate>
                                            </ItemsControl.ItemTemplate>
                                        </ItemsControl>
                                    </ScrollViewer>
                                </Border>

                                <Border Grid.Row="2" Style="{StaticResource Card}" Margin="0,10,0,0"
                                        Padding="14,11">
                                    <StackPanel>
                                        <TextBlock Text="资源快照" Style="{StaticResource SectionTitle}" />
                                        <TextBlock Text="{Binding ResourceSnapshotText}"
                                                   FontSize="11.5"
                                                   FontFamily="Consolas, Microsoft YaHei UI"
                                                   Foreground="{DynamicResource TextMutedBrush}"
                                                   TextWrapping="Wrap" Margin="0,7,0,0"
                                                   LineHeight="19" />
                                    </StackPanel>
                                </Border>
                            </Grid>
                        </Grid>
                    </Grid>

                    <!-- ========== 设置页 ========== -->
                    <Grid Visibility="{Binding IsSettingsPage, Converter={StaticResource BoolToVis}}">
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="*" />
                        </Grid.RowDefinitions>

                        <TextBlock Text="设置" Style="{StaticResource PageTitle}"
                                   Margin="34,24,0,0" />

                        <ScrollViewer Grid.Row="1" Style="{StaticResource SlimScrollViewer}"
                                      VerticalScrollBarVisibility="Auto"
                                      Margin="0,16,0,0">
                            <StackPanel Margin="34,0,34,26" MaxWidth="760"
                                        HorizontalAlignment="Center" Width="760">

                                <TextBlock Text="下载" Style="{StaticResource SectionTitle}"
                                           Margin="4,0,0,8" />
                                <Border Style="{StaticResource Card}" Padding="18">
                                    <StackPanel>
                                        <!--
                                            尺寸全部交给 InputBox 样式（Height=36 / Padding），
                                            这里只指定宽度。两个数字框必须等宽，否则右边缘参差。
                                        -->
                                        <Grid Margin="0,0,0,16">
                                            <StackPanel VerticalAlignment="Center">
                                                <TextBlock Text="并发线程数" FontSize="13" />
                                                <TextBlock Text="分片并发数，网络好时可调高"
                                                           Style="{StaticResource CaptionText}"
                                                           Margin="0,3,0,0" />
                                            </StackPanel>
                                            <TextBox Style="{StaticResource InputBox}"
                                                     Width="92"
                                                     HorizontalAlignment="Right"
                                                     VerticalAlignment="Center"
                                                     TextAlignment="Center"
                                                     Text="{Binding Threads,
                                                       UpdateSourceTrigger=PropertyChanged}" />
                                        </Grid>

                                        <Grid Margin="0,0,0,16">
                                            <StackPanel VerticalAlignment="Center">
                                                <TextBlock Text="限速 (KB/s)" FontSize="13" />
                                                <TextBlock Text="0 表示不限速"
                                                           Style="{StaticResource CaptionText}"
                                                           Margin="0,3,0,0" />
                                            </StackPanel>
                                            <TextBox Style="{StaticResource InputBox}"
                                                     Width="92"
                                                     HorizontalAlignment="Right"
                                                     VerticalAlignment="Center"
                                                     TextAlignment="Center"
                                                     Text="{Binding SpeedLimitKb,
                                                       UpdateSourceTrigger=PropertyChanged}" />
                                        </Grid>

                                        <Border Height="1" Background="{StaticResource BorderBrush}"
                                                Margin="0,0,0,14" />

                                        <CheckBox Style="{StaticResource ToggleSwitch}"
                                                  Content="断点续传" IsChecked="{Binding ResumeEnabled}"
                                                  Margin="0,5" />
                                        <CheckBox Style="{StaticResource ToggleSwitch}"
                                                  Content="慢连接抢占（慢连接断开重连提速）"
                                                  IsChecked="{Binding PreemptEnabled}" Margin="0,5" />
                                        <CheckBox Style="{StaticResource ToggleSwitch}"
                                                  Content="分片级校验（首尾抽查，能发现写偏移错位）"
                                                  IsChecked="{Binding VerifyChunks}" Margin="0,5" />
                                        <CheckBox Style="{StaticResource ToggleSwitch}"
                                                  Content="完成后计算 SHA-256（需完整读一遍文件，大文件较慢）"
                                                  IsChecked="{Binding VerifyHash}" Margin="0,5" />
                                        <CheckBox Style="{StaticResource ToggleSwitch}"
                                                  Content="完成后自动打开所在目录"
                                                  IsChecked="{Binding OpenFolderWhenDone}" Margin="0,5" />
                                        <CheckBox Style="{StaticResource ToggleSwitch}"
                                                  Content="完成时弹通知（窗口在后台才提示）"
                                                  IsChecked="{Binding NotifyOnComplete}" Margin="0,5" />
                                    </StackPanel>
                                </Border>

                                <TextBlock Text="保存位置" Style="{StaticResource SectionTitle}"
                                           Margin="4,20,0,8" />
                                <Border Style="{StaticResource Card}" Padding="18">
                                    <Grid>
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*" />
                                            <ColumnDefinition Width="Auto" />
                                        </Grid.ColumnDefinitions>
                                        <TextBox Style="{StaticResource InputBox}"
                                                 Text="{Binding DownloadDir,
                                                   UpdateSourceTrigger=PropertyChanged}"
                                                 ToolTip="{Binding DownloadDir}" />
                                        <Button Grid.Column="1" Style="{StaticResource GhostButton}"
                                                Command="{Binding BrowseDirCommand}"
                                                Content="浏览…" Margin="8,0,0,0" />
                                    </Grid>
                                </Border>

                                <Border Style="{StaticResource Card}" Padding="18" Margin="0,10,0,0">
                                    <StackPanel>
                                        <Grid>
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="*" />
                                                <ColumnDefinition Width="Auto" />
                                            </Grid.ColumnDefinitions>
                                            <StackPanel Grid.Column="0" VerticalAlignment="Center">
                                                <TextBlock Text="分片缓存目录" FontSize="13" />
                                                <TextBlock Text="{Binding CacheDirText}"
                                                           Style="{StaticResource CaptionText}"
                                                           TextTrimming="CharacterEllipsis"
                                                           MaxWidth="380" Margin="0,3,0,0"
                                                           HorizontalAlignment="Left" />
                                            </StackPanel>
                                            <StackPanel Grid.Column="1" Orientation="Horizontal"
                                                        VerticalAlignment="Center">
                                                <Button Style="{StaticResource GhostButton}"
                                                        Content="打开" FontSize="11.5" Padding="9,4"
                                                        Command="{Binding OpenCacheDirCommand}" />
                                                <Button Style="{StaticResource GhostButton}"
                                                        Content="更改…" FontSize="11.5" Padding="9,4"
                                                        Margin="6,0,0,0"
                                                        Command="{Binding BrowseCacheDirCommand}" />
                                            </StackPanel>
                                        </Grid>
                                        <TextBlock Style="{StaticResource CaptionText}"
                                                   TextWrapping="Wrap" Margin="0,9,0,0"
                                                   Text="下载中的分片放在这里，完成后搬到下载目录。放 SSD 能明显减少随机写等待；留空则与下载目录相同。" />

                                        <Border Height="1" Background="{DynamicResource BorderBrush}"
                                                Margin="0,13,0,12" />

                                        <Grid>
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="*" />
                                                <ColumnDefinition Width="Auto" />
                                            </Grid.ColumnDefinitions>
                                            <StackPanel Grid.Column="0" VerticalAlignment="Center">
                                                <TextBlock Text="数据库位置" FontSize="13" />
                                                <TextBlock Text="{Binding DatabasePathText}"
                                                           Style="{StaticResource CaptionText}"
                                                           TextTrimming="CharacterEllipsis"
                                                           MaxWidth="380" Margin="0,3,0,0"
                                                           HorizontalAlignment="Left" />
                                            </StackPanel>
                                            <Button Grid.Column="1" Style="{StaticResource GhostButton}"
                                                    Content="打开" FontSize="11.5" Padding="9,4"
                                                    VerticalAlignment="Center"
                                                    Command="{Binding OpenDbDirCommand}" />
                                        </Grid>
                                        <TextBlock Style="{StaticResource CaptionText}"
                                                   TextWrapping="Wrap" Margin="0,9,0,0"
                                                   Text="任务记录、解析历史、收藏与加密凭证都在这个文件里。备份整个 %APPDATA%\YunX-Desktop-CS 目录即可完整迁移。" />
                                    </StackPanel>
                                </Border>

                                <TextBlock Text="外观" Style="{StaticResource SectionTitle}"
                                           Margin="4,20,0,8" />
                                <Border Style="{StaticResource Card}" Padding="18">
                                    <StackPanel>
                                        <TextBlock Text="强调色" FontSize="13" />
                                        <TextBlock Style="{StaticResource CaptionText}"
                                                   TextWrapping="Wrap" Margin="0,3,0,10"
                                                   Text="只换强调色一族（按钮 / 进度条 / 选中态）；背景与正文保持中性灰，保证可读性。悬停与按下态由种子色按色相不变、亮度加减推导。" />

                                        <ItemsControl ItemsSource="{Binding SeedPresets}">
                                            <ItemsControl.ItemsPanel>
                                                <ItemsPanelTemplate>
                                                    <StackPanel Orientation="Horizontal" />
                                                </ItemsPanelTemplate>
                                            </ItemsControl.ItemsPanel>
                                            <ItemsControl.ItemTemplate>
                                                <DataTemplate>
                                                    <Button Style="{StaticResource IconButton}"
                                                            Width="34" Height="34" Margin="0,0,9,0"
                                                            ToolTip="{Binding Name}"
                                                            Command="{Binding DataContext.ApplySeedColorCommand,
                                                              RelativeSource={RelativeSource AncestorType=Window}}"
                                                            CommandParameter="{Binding Hex}">
                                                        <Ellipse Width="20" Height="20"
                                                                 Fill="{Binding Fill}" />
                                                    </Button>
                                                </DataTemplate>
                                            </ItemsControl.ItemTemplate>
                                        </ItemsControl>

                                        <Border Height="1" Background="{DynamicResource BorderBrush}"
                                                Margin="0,14,0,12" />

                                        <Grid>
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="*" />
                                                <ColumnDefinition Width="Auto" />
                                            </Grid.ColumnDefinitions>
                                            <StackPanel Grid.Column="0" VerticalAlignment="Center">
                                                <TextBlock Text="关闭窗口时" FontSize="13" />
                                                <TextBlock Style="{StaticResource CaptionText}"
                                                           TextWrapping="Wrap" MaxWidth="400"
                                                           HorizontalAlignment="Left"
                                                           Margin="0,3,0,0"
                                                           Text="有任务在下载时按 × 的行为。选「最小化到托盘」可以边下边干别的。" />
                                            </StackPanel>
                                            <ComboBox Grid.Column="1"
                                                      ItemsSource="{Binding CloseBehaviorLabels}"
                                                      SelectedItem="{Binding CloseBehaviorLabel}"
                                                      Width="170" VerticalAlignment="Center"
                                                      FontFamily="Microsoft YaHei UI"
                                                      FontSize="12" />
                                        </Grid>
                                    </StackPanel>
                                </Border>

                                <TextBlock Text="网络" Style="{StaticResource SectionTitle}"
                                           Margin="4,20,0,8" />
                                <Border Style="{StaticResource Card}" Padding="18">
                                    <StackPanel>
                                        <Grid Margin="0,0,0,14">
                                            <StackPanel>
                                                <TextBlock Text="联网模式" FontSize="13" />
                                                <TextBlock Text="{Binding NetModeText}"
                                                           Style="{StaticResource CaptionText}"
                                                           Margin="0,3,0,0" />
                                            </StackPanel>
                                            <ComboBox ItemsSource="{Binding NetModes}"
                                                      SelectedItem="{Binding NetModeLabel}"
                                                      Width="170" HorizontalAlignment="Right"
                                                      FontFamily="Microsoft YaHei UI"
                                                      FontSize="12" />
                                        </Grid>

                                        <Grid Margin="0,0,0,14">
                                            <StackPanel>
                                                <TextBlock Text="下载线路" FontSize="13" />
                                                <TextBlock Text="auto = 自动测速择优"
                                                           Style="{StaticResource CaptionText}"
                                                           Margin="0,3,0,0" />
                                            </StackPanel>
                                            <ComboBox ItemsSource="{Binding MirrorOptions}"
                                                      SelectedItem="{Binding MirrorLabel}"
                                                      Width="170" HorizontalAlignment="Right"
                                                      FontFamily="Microsoft YaHei UI"
                                                      FontSize="12" />
                                        </Grid>

                                        <Border Height="1" Background="{StaticResource BorderBrush}"
                                                Margin="0,0,0,14" />

                                        <CheckBox Style="{StaticResource ToggleSwitch}"
                                                  Content="绕过 hosts 劫持（DoH 解析真实 IP）"
                                                  IsChecked="{Binding BypassHosts}" Margin="0,5" />
                                    </StackPanel>
                                </Border>

                                <TextBlock Text="GitHub 访问" Style="{StaticResource SectionTitle}"
                                           Margin="4,20,0,8" />
                                <Border Style="{StaticResource Card}" Padding="18">
                                    <StackPanel>
                                        <TextBlock Text="Personal Access Token" FontSize="13" />
                                        <TextBlock Text="填入后提高 API 限额、支持私有仓库。私有仓库只走直连（镜像不转发鉴权头）"
                                                   Style="{StaticResource CaptionText}"
                                                   TextWrapping="Wrap" Margin="0,4,0,9" />
                                        <PasswordBox x:Name="TokenBox"
                                                     Style="{StaticResource InputPassword}" />
                                        <TextBlock Text="{Binding TokenError}"
                                                   FontSize="11.5"
                                                   Foreground="{StaticResource ErrBrush}"
                                                   TextWrapping="Wrap" Margin="0,7,0,0"
                                                   Visibility="{Binding TokenError,
                                                     Converter={StaticResource NullToVis}}" />
                                    </StackPanel>
                                </Border>


                                <TextBlock Text="诊断与日志" Style="{StaticResource SectionTitle}"
                                           Margin="4,20,0,8" />
                                <Border Style="{StaticResource Card}" Padding="18">
                                    <StackPanel>
                                        <CheckBox Style="{StaticResource ToggleSwitch}"
                                                  Content="诊断模式（6 模块分文件日志，300 行/秒限流）"
                                                  IsChecked="{Binding DiagnosticsEnabled}" Margin="0,5" />
                                        <CheckBox Style="{StaticResource ToggleSwitch}"
                                                  Content="下载调试（按任务记录事件流）"
                                                  IsChecked="{Binding DownloadDebugEnabled}" Margin="0,5" />
                                        <Button Style="{StaticResource GhostButton}"
                                                Content="导出诊断日志 (zip)" FontSize="12"
                                                Command="{Binding ExportLogsCommand}"
                                                HorizontalAlignment="Right" Margin="0,10,0,0" />
                                    </StackPanel>
                                </Border>

                                <TextBlock Text="实验性功能" Style="{StaticResource SectionTitle}"
                                           Margin="4,20,0,8" />
                                <Border Style="{StaticResource Card}" Padding="18">
                                    <StackPanel>
                                        <TextBlock Text="高风险 / 可调下载参数。超出合理范围仍可启用，但风险自负。"
                                                   Style="{StaticResource CaptionText}"
                                                   TextWrapping="Wrap" Margin="0,0,0,12" />

                                        <Grid Margin="0,0,0,12">
                                            <StackPanel>
                                                <TextBlock Text="读缓冲 (KB)" FontSize="13" />
                                                <TextBlock Text="合理 16–1024 · 上限 4096"
                                                           Style="{StaticResource CaptionText}"
                                                           Margin="0,3,0,0" />
                                            </StackPanel>
                                            <TextBox Style="{StaticResource InputBox}" Width="92"
                                                     HorizontalAlignment="Right" TextAlignment="Center"
                                                     Text="{Binding ReadBufferKb, UpdateSourceTrigger=PropertyChanged}" />
                                        </Grid>

                                        <Grid Margin="0,0,0,12">
                                            <StackPanel>
                                                <TextBlock Text="抢占阈值 (KB/s)" FontSize="13" />
                                                <TextBlock Text="合理 4–1024 · 上限 10240"
                                                           Style="{StaticResource CaptionText}"
                                                           Margin="0,3,0,0" />
                                            </StackPanel>
                                            <TextBox Style="{StaticResource InputBox}" Width="92"
                                                     HorizontalAlignment="Right" TextAlignment="Center"
                                                     Text="{Binding PreemptFloorKb, UpdateSourceTrigger=PropertyChanged}" />
                                        </Grid>

                                        <Grid Margin="0,0,0,12">
                                            <StackPanel>
                                                <TextBlock Text="抢占判定时长 (秒)" FontSize="13" />
                                                <TextBlock Text="合理 5–120 · 上限 600"
                                                           Style="{StaticResource CaptionText}"
                                                           Margin="0,3,0,0" />
                                            </StackPanel>
                                            <TextBox Style="{StaticResource InputBox}" Width="92"
                                                     HorizontalAlignment="Right" TextAlignment="Center"
                                                     Text="{Binding PreemptAgeSec, UpdateSourceTrigger=PropertyChanged}" />
                                        </Grid>

                                        <Grid Margin="0,0,0,12">
                                            <StackPanel>
                                                <TextBlock Text="同时下载任务数" FontSize="13" />
                                                <TextBlock Text="默认 1：前台任务吃满带宽，其余排队"
                                                           Style="{StaticResource CaptionText}"
                                                           Margin="0,3,0,0" />
                                            </StackPanel>
                                            <TextBox Style="{StaticResource InputBox}" Width="92"
                                                     HorizontalAlignment="Right" TextAlignment="Center"
                                                     Text="{Binding MaxConcurrentTasks, UpdateSourceTrigger=PropertyChanged}" />
                                        </Grid>

                                        <Grid Margin="0,0,0,12">
                                            <StackPanel Margin="0,0,110,0">
                                                <TextBlock Text="下载历史保留条数" FontSize="13" />
                                                <TextBlock Text="已完成的任务会留在列表里方便回看；超出条数的从最旧的开始清掉。最小 1 条"
                                                           Style="{StaticResource CaptionText}"
                                                           TextWrapping="Wrap" Margin="0,3,0,0" />
                                            </StackPanel>
                                            <TextBox Style="{StaticResource InputBox}" Width="92"
                                                     HorizontalAlignment="Right" VerticalAlignment="Top"
                                                     TextAlignment="Center"
                                                     Text="{Binding CompletedHistoryLimit, UpdateSourceTrigger=PropertyChanged}" />
                                        </Grid>

                                        <Border Height="1" Background="{StaticResource BorderBrush}"
                                                Margin="0,0,0,12" />

                                        <CheckBox Style="{StaticResource ToggleSwitch}"
                                                  Content="启用 HTTP/2（默认关闭，仅用 HTTP/1.1）"
                                                  IsChecked="{Binding EnableHttp2}" Margin="0,5" />
                                        <CheckBox Style="{StaticResource ToggleSwitch}"
                                                  Content="下载期间阻止系统睡眠"
                                                  IsChecked="{Binding KeepAwake}" Margin="0,5" />
                                        <CheckBox Style="{StaticResource ToggleSwitch}"
                                                  Content="检测剪贴板中的分享链接"
                                                  IsChecked="{Binding ClipboardWatch}" Margin="0,5" />

                                        <Button Style="{StaticResource GhostButton}"
                                                Content="重置为默认值" FontSize="12"
                                                Command="{Binding ResetTuningCommand}"
                                                HorizontalAlignment="Right" Margin="0,10,0,0" />
                                    </StackPanel>
                                </Border>

                                <TextBlock Text="磁力下载" Style="{StaticResource SectionTitle}"
                                           Margin="4,20,0,8" />
                                <Border Style="{StaticResource Card}" Padding="18">
                                    <StackPanel>
                                        <Grid>
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="*" />
                                                <ColumnDefinition Width="Auto" />
                                            </Grid.ColumnDefinitions>
                                            <StackPanel Grid.Column="0" VerticalAlignment="Center">
                                                <TextBlock Text="Gopeed 内核" FontSize="13" />
                                                <TextBlock Text="{Binding GopeedVersionText}"
                                                           Style="{StaticResource CaptionText}"
                                                           Margin="0,3,0,0" />
                                            </StackPanel>
                                            <Button Grid.Column="1" Style="{StaticResource GhostButton}"
                                                    Content="下载并安装内核" FontSize="11.5" Padding="10,4"
                                                    VerticalAlignment="Center"
                                                    Command="{Binding InstallGopeedCommand}"
                                                    IsEnabled="{Binding CanInstallGopeed}" />
                                        </Grid>

                                        <TextBlock Text="{Binding GopeedInstallText}"
                                                   Style="{StaticResource CaptionText}"
                                                   TextWrapping="Wrap" Margin="0,8,0,0"
                                                   Visibility="{Binding GopeedInstallText,
                                                     Converter={StaticResource NotEmptyToVis}}" />

                                        <Border Height="1" Background="{StaticResource BorderBrush}"
                                                Margin="0,12,0,10" />

                                        <TextBlock Style="{StaticResource CaptionText}"
                                                   TextWrapping="Wrap" LineHeight="19"
                                                   Text="磁力下载由 Gopeed 官方内核（独立子进程）完成：它能处理 DHT / tracker / peer 调度，本项目只负责调度与界面。首次使用需联网下载约 20~30 MB；内核未安装时磁力任务会给出明确提示而不是静默失败。" />
                                    </StackPanel>
                                </Border>

                                <!--
                                    保存按钮放右下角。
                                    Windows 惯例里「提交/确认」类主操作在右下（或居中），
                                    左下是"返回/取消"的位置 —— 放左下会让人下意识以为
                                    那一侧是次要动作。
                                -->
                                <Button Style="{StaticResource PrimaryButton}"
                                        Command="{Binding SaveSettingsCommand}"
                                        Content="保存设置" Margin="0,20,0,0"
                                        HorizontalAlignment="Right" MinWidth="120" />

                                <!--
                                    协议声明：AGPL 要求分发时让使用者知道自己的权利。
                                    放在设置页底部而不是弹窗里 —— 不打扰，但随时可查。
                                    版本号取自程序集，避免硬编码后忘记改。
                                -->
                                <!--
                                    版权/版本号：居中放在页面最底部。
                                    这是"说明性"信息而非操作项，居中收尾比左对齐更像个页脚，
                                    也不会与上面的按钮（右对齐）抢视觉重心。
                                -->
                                <TextBlock Style="{StaticResource CaptionText}"
                                           TextWrapping="Wrap" LineHeight="18"
                                           Margin="0,18,0,0"
                                           HorizontalAlignment="Center"
                                           TextAlignment="Center"
                                           Text="{Binding AboutText}" />
                            </StackPanel>
                        </ScrollViewer>
                    </Grid>

                    <!-- ========== 剪贴板提示卡片（覆盖在内容区右下角） ========== -->
                    <!--
                        不用模态弹窗打断用户：复制链接是高频动作，
                        每次都弹窗会让人烦。做成可点可忽略的浮层。
                    -->
                    <Border x:Name="ClipboardHintCard"
                            HorizontalAlignment="Right" VerticalAlignment="Bottom"
                            Margin="0,0,28,22" MaxWidth="440"
                            Background="{StaticResource SurfaceTopBrush}"
                            BorderBrush="{StaticResource BorderHiBrush}"
                            BorderThickness="1" CornerRadius="10"
                            Padding="14,11"
                            Visibility="{Binding ClipboardHintVisible,
                              Converter={StaticResource BoolToVis}}"
                            Panel.ZIndex="10">
                        <Border.Effect>
                            <DropShadowEffect Color="#000000" BlurRadius="22"
                                              ShadowDepth="4" Opacity="0.55" />
                        </Border.Effect>
                        <Border.RenderTransform>
                            <TranslateTransform x:Name="HintTransform" Y="0" />
                        </Border.RenderTransform>

                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto" />
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>

                            <Path Data="{StaticResource IconLink}" Width="15" Height="15"
                                  Stretch="Uniform" VerticalAlignment="Center"
                                  Fill="{DynamicResource AccentBrush}" />

                            <StackPanel Grid.Column="1" Margin="10,0,10,0"
                                        VerticalAlignment="Center">
                                <TextBlock Text="剪贴板里有链接" FontSize="12" FontWeight="Medium"
                                           Foreground="{StaticResource TextBrush}" />
                                <TextBlock Text="{Binding ClipboardHintText}"
                                           Style="{StaticResource CaptionText}"
                                           TextTrimming="CharacterEllipsis" MaxWidth="260"
                                           Margin="0,3,0,0" />
                            </StackPanel>

                            <Button Grid.Column="2" Style="{StaticResource GhostButton}"
                                    Content="填入" FontSize="11.5" Padding="10,4"
                                    Command="{Binding UseClipboardHintCommand}" />

                            <Button Grid.Column="3" Style="{StaticResource IconButton}"
                                    Width="24" Height="24" Margin="6,0,0,0"
                                    Command="{Binding DismissClipboardHintCommand}"
                                    ToolTip="忽略">
                                <Path Data="{StaticResource IconClose}" Width="9" Height="9"
                                      Stretch="Uniform" HorizontalAlignment="Center"
                                      VerticalAlignment="Center"
                                      Fill="{StaticResource TextDimBrush}" />
                            </Button>
                        </Grid>
                    </Border>
                </Grid>
            </Grid>

            <!-- ================= 状态栏 ================= -->
            <Grid Grid.Row="2" Height="34">
                <Border Background="#0E1117" BorderBrush="{StaticResource BorderBrush}"
                        BorderThickness="0,1,0,0" />
                <Grid Margin="18,0">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>

                    <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                        <Ellipse Width="6" Height="6" VerticalAlignment="Center"
                                 Fill="{Binding StatusDotBrush}" />
                        <TextBlock Text="{Binding StatusText}" Style="{StaticResource CaptionText}"
                                   Margin="8,0,0,0" VerticalAlignment="Center" />
                    </StackPanel>

                    <TextBlock Grid.Column="1" Text="{Binding TotalSpeedText}"
                               Style="{StaticResource CaptionText}"
                               Margin="18,0,0,0" VerticalAlignment="Center" />

                    <Grid Grid.Column="2" Height="4" Margin="20,0" x:Name="TotalBarHost"
                          VerticalAlignment="Center" MaxWidth="300"
                          HorizontalAlignment="Right"
                          Visibility="{Binding HasTasks,
                            Converter={StaticResource BoolToVis}}">
                        <Border Background="{StaticResource SurfaceTopBrush}" CornerRadius="2" />
                        <Border HorizontalAlignment="Left" CornerRadius="2"
                                Background="{DynamicResource AccentBrush}">
                            <Border.Width>
                                <MultiBinding Converter="{StaticResource PercentToWidth}">
                                    <Binding Path="TotalPercent" />
                                    <Binding Path="ActualWidth" ElementName="TotalBarHost" />
                                </MultiBinding>
                            </Border.Width>
                        </Border>
                    </Grid>

                    <TextBlock Grid.Column="3" Text="{Binding NetModeShort}"
                               Style="{StaticResource CaptionText}"
                               VerticalAlignment="Center" />
                </Grid>
            </Grid>
        </Grid>
    </Border>
</Window>
