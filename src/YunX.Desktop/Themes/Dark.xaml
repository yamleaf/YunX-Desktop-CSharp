<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

    <!--
        设计系统：所有颜色 / 尺寸 / 字体只在这里定义，界面文件只引用语义化 key。
        改主题不需要动任何布局。

        取色依据：深色底 + 单一强调色（蓝），分层靠 surface 的明度差而非描边，
        描边只在需要区分层级时使用，且对比度压低（#252A35）避免"表格感"。
    -->

    <!-- ===== 表面层级：从最深到最浅，数值差控制在 6~8 之间，视觉上连续过渡 ===== -->
    <Color x:Key="BgColor">#0B0D11</Color>
    <Color x:Key="SurfaceColor">#14171E</Color>
    <Color x:Key="SurfaceHiColor">#1B1F28</Color>
    <Color x:Key="SurfaceTopColor">#22262F</Color>
    <Color x:Key="BorderColor">#252A35</Color>
    <Color x:Key="BorderHiColor">#333A47</Color>

    <!-- ===== 强调色：主色 + 悬停 + 按下 + 弱化底 ===== -->
    <Color x:Key="AccentColor">#4C8BF5</Color>
    <Color x:Key="AccentHiColor">#6BA1FF</Color>
    <Color x:Key="AccentPressColor">#3D74D6</Color>
    <Color x:Key="AccentSoftColor">#1C2A44</Color>

    <!-- ===== 文本层级：主 / 次 / 弱，三级足够 ===== -->
    <Color x:Key="TextColor">#E8EBF0</Color>
    <Color x:Key="TextMutedColor">#9AA4B2</Color>
    <Color x:Key="TextDimColor">#66707E</Color>

    <!-- ===== 语义色 ===== -->
    <Color x:Key="OkColor">#4ADE80</Color>
    <Color x:Key="ErrColor">#F87171</Color>
    <Color x:Key="WarnColor">#FBBF24</Color>

    <SolidColorBrush x:Key="BgBrush" Color="{DynamicResource BgColor}" />
    <SolidColorBrush x:Key="SurfaceBrush" Color="{DynamicResource SurfaceColor}" />
    <SolidColorBrush x:Key="SurfaceHiBrush" Color="{DynamicResource SurfaceHiColor}" />
    <SolidColorBrush x:Key="SurfaceTopBrush" Color="{DynamicResource SurfaceTopColor}" />
    <SolidColorBrush x:Key="BorderBrush" Color="{DynamicResource BorderColor}" />
    <SolidColorBrush x:Key="BorderHiBrush" Color="{DynamicResource BorderHiColor}" />
    <SolidColorBrush x:Key="AccentBrush" Color="{DynamicResource AccentColor}" />
    <SolidColorBrush x:Key="AccentHiBrush" Color="{DynamicResource AccentHiColor}" />
    <SolidColorBrush x:Key="AccentPressBrush" Color="{DynamicResource AccentPressColor}" />
    <SolidColorBrush x:Key="AccentSoftBrush" Color="{DynamicResource AccentSoftColor}" />
    <SolidColorBrush x:Key="TextBrush" Color="{DynamicResource TextColor}" />
    <SolidColorBrush x:Key="TextMutedBrush" Color="{DynamicResource TextMutedColor}" />
    <SolidColorBrush x:Key="TextDimBrush" Color="{DynamicResource TextDimColor}" />
    <SolidColorBrush x:Key="OkBrush" Color="{DynamicResource OkColor}" />
    <SolidColorBrush x:Key="ErrBrush" Color="{DynamicResource ErrColor}" />
    <SolidColorBrush x:Key="WarnBrush" Color="{DynamicResource WarnColor}" />

    <!-- 强调色渐变：按钮与进度条用，比纯色更有质感 -->
    <LinearGradientBrush x:Key="AccentGradient" StartPoint="0,0" EndPoint="1,1">
        <GradientStop Color="#5A97FF" Offset="0" />
        <GradientStop Color="#3F7BE8" Offset="1" />
    </LinearGradientBrush>

    <LinearGradientBrush x:Key="AccentGradientH" StartPoint="0,0" EndPoint="1,0">
        <GradientStop Color="#5A97FF" Offset="0" />
        <GradientStop Color="#4C8BF5" Offset="0.5" />
        <GradientStop Color="#3F7BE8" Offset="1" />
    </LinearGradientBrush>

    <!-- 窗口背景的极淡径向渐变：给大片纯色底一点纵深，几乎察觉不到但不显平 -->
    <RadialGradientBrush x:Key="WindowBackdrop" Center="0.3,0.05" GradientOrigin="0.3,0.05"
                         RadiusX="0.9" RadiusY="0.9">
        <GradientStop Color="#12151C" Offset="0" />
        <GradientStop Color="#0B0D11" Offset="1" />
    </RadialGradientBrush>

    <!-- ===== 字体 ===== -->
    <FontFamily x:Key="UiFont">Microsoft YaHei UI, Segoe UI</FontFamily>
    <FontFamily x:Key="MonoFont">Cascadia Mono, Consolas, Courier New</FontFamily>

    <!-- ===== 文本样式 ===== -->
    <Style TargetType="TextBlock">
        <Setter Property="Foreground" Value="{DynamicResource TextBrush}" />
        <Setter Property="FontFamily" Value="{StaticResource UiFont}" />
        <Setter Property="FontSize" Value="13" />
        <Setter Property="TextOptions.TextFormattingMode" Value="Display" />
        <Setter Property="TextOptions.TextRenderingMode" Value="ClearType" />
    </Style>

    <Style x:Key="PageTitle" TargetType="TextBlock">
        <Setter Property="Foreground" Value="{DynamicResource TextBrush}" />
        <Setter Property="FontFamily" Value="{StaticResource UiFont}" />
        <Setter Property="FontSize" Value="22" />
        <Setter Property="FontWeight" Value="SemiBold" />
        <Setter Property="TextOptions.TextFormattingMode" Value="Display" />
    </Style>

    <Style x:Key="SectionTitle" TargetType="TextBlock">
        <Setter Property="Foreground" Value="{DynamicResource TextMutedBrush}" />
        <Setter Property="FontFamily" Value="{StaticResource UiFont}" />
        <Setter Property="FontSize" Value="11.5" />
        <Setter Property="FontWeight" Value="SemiBold" />
        <Setter Property="TextOptions.TextFormattingMode" Value="Display" />
    </Style>

    <Style x:Key="MutedText" TargetType="TextBlock">
        <Setter Property="Foreground" Value="{DynamicResource TextMutedBrush}" />
        <Setter Property="FontFamily" Value="{StaticResource UiFont}" />
        <Setter Property="FontSize" Value="12" />
        <Setter Property="TextOptions.TextFormattingMode" Value="Display" />
    </Style>

    <Style x:Key="CaptionText" TargetType="TextBlock">
        <Setter Property="Foreground" Value="{DynamicResource TextDimBrush}" />
        <Setter Property="FontFamily" Value="{StaticResource UiFont}" />
        <Setter Property="FontSize" Value="11" />
        <Setter Property="TextOptions.TextFormattingMode" Value="Display" />
    </Style>

    <!-- ============================================================
         窗口控制按钮（自绘标题栏用）
         ============================================================ -->
    <Style x:Key="CaptionButton" TargetType="Button">
        <Setter Property="Width" Value="46" />
        <Setter Property="Height" Value="36" />
        <Setter Property="Background" Value="Transparent" />
        <Setter Property="Foreground" Value="{DynamicResource TextMutedBrush}" />
        <Setter Property="BorderThickness" Value="0" />
        <Setter Property="Cursor" Value="Hand" />
        <Setter Property="Focusable" Value="False" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="Button">
                    <Border x:Name="bd" Background="{TemplateBinding Background}">
                        <ContentPresenter HorizontalAlignment="Center"
                                          VerticalAlignment="Center" />
                    </Border>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter TargetName="bd" Property="Background" Value="#26FFFFFF" />
                            <Setter Property="Foreground" Value="{DynamicResource TextBrush}" />
                        </Trigger>
                        <Trigger Property="IsPressed" Value="True">
                            <Setter TargetName="bd" Property="Background" Value="#33FFFFFF" />
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <Style x:Key="CloseCaptionButton" TargetType="Button" BasedOn="{StaticResource CaptionButton}">
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="Button">
                    <Border x:Name="bd" Background="{TemplateBinding Background}">
                        <ContentPresenter HorizontalAlignment="Center"
                                          VerticalAlignment="Center" />
                    </Border>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter TargetName="bd" Property="Background" Value="#E81123" />
                            <Setter Property="Foreground" Value="#FFFFFF" />
                        </Trigger>
                        <Trigger Property="IsPressed" Value="True">
                            <Setter TargetName="bd" Property="Background" Value="#C50F1F" />
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!-- ============================================================
         侧边导航项：ToggleButton + 选中态（左侧强调条 + 底色）
         ============================================================ -->
    <Style x:Key="NavItem" TargetType="ToggleButton">
        <Setter Property="Height" Value="42" />
        <Setter Property="Cursor" Value="Hand" />
        <Setter Property="Focusable" Value="False" />
        <Setter Property="Foreground" Value="{DynamicResource TextMutedBrush}" />
        <Setter Property="HorizontalContentAlignment" Value="Stretch" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="ToggleButton">
                    <Grid Background="Transparent">
                        <!-- 选中指示条 -->
                        <Border x:Name="bar" Width="3" Height="18" CornerRadius="2"
                                HorizontalAlignment="Left" VerticalAlignment="Center"
                                Background="{DynamicResource AccentBrush}" Opacity="0" />
                        <Border x:Name="pill" CornerRadius="8" Margin="10,2"
                                Background="Transparent">
                            <ContentPresenter VerticalAlignment="Center" Margin="12,0" />
                        </Border>
                    </Grid>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter TargetName="pill" Property="Background" Value="#14FFFFFF" />
                            <Setter Property="Foreground" Value="{DynamicResource TextBrush}" />
                        </Trigger>
                        <Trigger Property="IsChecked" Value="True">
                            <Setter TargetName="pill" Property="Background"
                                    Value="{DynamicResource AccentSoftBrush}" />
                            <Setter TargetName="bar" Property="Opacity" Value="1" />
                            <Setter Property="Foreground" Value="{DynamicResource TextBrush}" />
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!-- ============================================================
         按钮
         ============================================================ -->
    <Style x:Key="GhostButton" TargetType="Button">
        <Setter Property="Foreground" Value="{DynamicResource TextBrush}" />
        <Setter Property="Background" Value="{DynamicResource SurfaceHiBrush}" />
        <Setter Property="BorderThickness" Value="1" />
        <Setter Property="BorderBrush" Value="{DynamicResource BorderBrush}" />
        <Setter Property="FontFamily" Value="{StaticResource UiFont}" />
        <Setter Property="FontSize" Value="12.5" />
        <Setter Property="Padding" Value="14,7" />
        <Setter Property="Cursor" Value="Hand" />
        <Setter Property="SnapsToDevicePixels" Value="True" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="Button">
                    <Border x:Name="bd" Background="{TemplateBinding Background}"
                            BorderBrush="{TemplateBinding BorderBrush}"
                            BorderThickness="{TemplateBinding BorderThickness}"
                            CornerRadius="7">
                        <ContentPresenter HorizontalAlignment="Center"
                                          VerticalAlignment="Center"
                                          Margin="{TemplateBinding Padding}" />
                    </Border>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter TargetName="bd" Property="Background"
                                    Value="{DynamicResource SurfaceTopBrush}" />
                            <Setter TargetName="bd" Property="BorderBrush"
                                    Value="{DynamicResource BorderHiBrush}" />
                        </Trigger>
                        <Trigger Property="IsPressed" Value="True">
                            <Setter TargetName="bd" Property="Background"
                                    Value="{DynamicResource SurfaceBrush}" />
                        </Trigger>
                        <Trigger Property="IsEnabled" Value="False">
                            <Setter Property="Opacity" Value="0.38" />
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!--
        小号按钮：给「全选 / 清空 / ‹ 上级 / 运行日志」这类紧凑操作区用。

        之前这些按钮用的是 IconButton（Background=Transparent、无描边），
        视觉上跟纯文字一样，用户看不出那是可点的按钮 —— 只有鼠标移上去才有反馈。
        但也不能直接套 GhostButton：它的 Padding 是 14,7、字号 12.5，
        放到标题行右侧这些密集位置会把整行撑高。

        所以单独一档：与 GhostButton 同一套配色和圆角，只把尺寸压小。
    -->
    <Style x:Key="SmallButton" TargetType="Button">
        <Setter Property="Foreground" Value="{DynamicResource TextMutedBrush}" />
        <Setter Property="Background" Value="{DynamicResource SurfaceHiBrush}" />
        <Setter Property="BorderThickness" Value="1" />
        <Setter Property="BorderBrush" Value="{DynamicResource BorderBrush}" />
        <Setter Property="FontFamily" Value="{StaticResource UiFont}" />
        <Setter Property="FontSize" Value="11" />
        <Setter Property="Padding" Value="9,3" />
        <Setter Property="Cursor" Value="Hand" />
        <Setter Property="Focusable" Value="False" />
        <Setter Property="SnapsToDevicePixels" Value="True" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="Button">
                    <Border x:Name="bd" Background="{TemplateBinding Background}"
                            BorderBrush="{TemplateBinding BorderBrush}"
                            BorderThickness="{TemplateBinding BorderThickness}"
                            CornerRadius="6">
                        <ContentPresenter HorizontalAlignment="Center"
                                          VerticalAlignment="Center"
                                          Margin="{TemplateBinding Padding}" />
                    </Border>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter TargetName="bd" Property="Background"
                                    Value="{DynamicResource SurfaceTopBrush}" />
                            <Setter TargetName="bd" Property="BorderBrush"
                                    Value="{DynamicResource BorderHiBrush}" />
                            <Setter Property="Foreground" Value="{DynamicResource TextBrush}" />
                        </Trigger>
                        <Trigger Property="IsPressed" Value="True">
                            <Setter TargetName="bd" Property="Background"
                                    Value="{DynamicResource SurfaceBrush}" />
                        </Trigger>
                        <Trigger Property="IsEnabled" Value="False">
                            <Setter Property="Opacity" Value="0.38" />
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <Style x:Key="PrimaryButton" TargetType="Button">
        <Setter Property="Foreground" Value="#FFFFFF" />
        <Setter Property="Background" Value="{DynamicResource AccentGradient}" />
        <Setter Property="BorderThickness" Value="0" />
        <Setter Property="FontFamily" Value="{StaticResource UiFont}" />
        <Setter Property="FontSize" Value="13" />
        <Setter Property="FontWeight" Value="SemiBold" />
        <Setter Property="Padding" Value="22,9" />
        <Setter Property="Cursor" Value="Hand" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="Button">
                    <Border x:Name="bd" Background="{TemplateBinding Background}"
                            CornerRadius="7">
                        <ContentPresenter HorizontalAlignment="Center"
                                          VerticalAlignment="Center"
                                          Margin="{TemplateBinding Padding}" />
                    </Border>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter TargetName="bd" Property="Background"
                                    Value="{DynamicResource AccentGradientH}" />
                        </Trigger>
                        <Trigger Property="IsPressed" Value="True">
                            <Setter TargetName="bd" Property="Background"
                                    Value="{DynamicResource AccentPressBrush}" />
                        </Trigger>
                        <Trigger Property="IsEnabled" Value="False">
                            <Setter Property="Opacity" Value="0.35" />
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!-- 图标按钮：无边框，只有悬停底色 -->
    <Style x:Key="IconButton" TargetType="Button">
        <Setter Property="Width" Value="30" />
        <Setter Property="Height" Value="30" />
        <Setter Property="Background" Value="Transparent" />
        <Setter Property="Foreground" Value="{DynamicResource TextMutedBrush}" />
        <Setter Property="BorderThickness" Value="0" />
        <Setter Property="Cursor" Value="Hand" />
        <Setter Property="Focusable" Value="False" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="Button">
                    <Border x:Name="bd" Background="{TemplateBinding Background}"
                            CornerRadius="6">
                        <ContentPresenter HorizontalAlignment="Center"
                                          VerticalAlignment="Center" />
                    </Border>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter TargetName="bd" Property="Background" Value="#1AFFFFFF" />
                            <Setter Property="Foreground" Value="{DynamicResource TextBrush}" />
                        </Trigger>
                        <Trigger Property="IsEnabled" Value="False">
                            <Setter Property="Opacity" Value="0.3" />
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!-- ============================================================
         输入框：聚焦时描边变强调色 + 加一层极淡光晕

         尺寸由样式统一规定（Height / Padding / FontSize），页面里**不要**再逐处
         覆写 Width/Height —— 之前设置页就因为这个出现 90 / 92 两种宽度、
         有的有高度有的没有，右侧边缘参差不齐。
         需要特定宽度的（如数字框）只改 Width，高度和内边距沿用样式。
         ============================================================ -->
    <Style x:Key="InputBox" TargetType="TextBox">
        <Setter Property="Background" Value="{DynamicResource SurfaceHiBrush}" />
        <Setter Property="Foreground" Value="{DynamicResource TextBrush}" />
        <Setter Property="CaretBrush" Value="{DynamicResource AccentBrush}" />
        <Setter Property="SelectionBrush" Value="{DynamicResource AccentBrush}" />
        <!--
          ★ BorderThickness 必须为 0：描边改由「外层纯色 Border」承担。
          见下方模板注释里的抗锯齿说明。
        -->
        <Setter Property="BorderThickness" Value="0" />
        <Setter Property="Padding" Value="13,0" />
        <Setter Property="Height" Value="36" />
        <Setter Property="FontFamily" Value="{StaticResource UiFont}" />
        <Setter Property="FontSize" Value="13" />
        <Setter Property="VerticalContentAlignment" Value="Center" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="TextBox">
                    <!--
                      ============================================================
                      抗锯齿混色的根因与改法
                      ============================================================

                      【根因】Border.BorderThickness 画的是「沿边框内缩的矩形环」。
                      对正方形来说环的内沿和外沿是等距的；但一旦有 CornerRadius，
                      弧段上内外沿的**长度不同**（外沿长、内沿短），
                      1px 的环在弧上会被拉成一条斜向的宽带 ——
                      于是弧段出现「半透明混色带」，放大看是毛边，缩小看是脏圈。

                      【改法】不用 BorderThickness：
                        外层 Border   ：纯色描边色，圆角 R
                        内层 Border   ：填充色，Margin="1"，圆角 R-1
                      Margin=1 让内层与外层**同心**（不是等比缩放），
                      两段弧线严格平行，抗锯齿只发生在
                      「单一色块 ↔ 窗口背景」之间，不会再有中间混色带。

                      半径同步减 1：36/8 → 外层 8、内层 7。
                      ============================================================
                    -->
                    <Border x:Name="bdStroke" CornerRadius="8"
                            Background="{DynamicResource BorderHiBrush}">
                        <Border x:Name="bdFill" CornerRadius="7" Margin="1"
                                Background="{TemplateBinding Background}">
                            <ScrollViewer x:Name="PART_ContentHost"
                                          VerticalAlignment="{TemplateBinding VerticalContentAlignment}"
                                          HorizontalScrollBarVisibility="Hidden"
                                          VerticalScrollBarVisibility="Hidden" />
                        </Border>
                    </Border>
                    <ControlTemplate.Triggers>
                        <!--
                          聚焦改的是**外层描边色**（单色块换色，不引入渐变/发光），
                          内层填充同时提亮一档，视觉上"整框浮起"。
                          两者都只动纯色，抗锯齿行为不变。
                        -->
                        <Trigger Property="IsKeyboardFocusWithin" Value="True">
                            <Setter TargetName="bdStroke" Property="Background"
                                    Value="{DynamicResource AccentHiBrush}" />
                            <Setter TargetName="bdFill" Property="Background"
                                    Value="{DynamicResource SurfaceTopBrush}" />
                        </Trigger>
                        <Trigger Property="IsEnabled" Value="False">
                            <Setter Property="Opacity" Value="0.5" />
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <Style x:Key="InputPassword" TargetType="PasswordBox">
        <Setter Property="Background" Value="{DynamicResource SurfaceHiBrush}" />
        <Setter Property="Foreground" Value="{DynamicResource TextBrush}" />
        <Setter Property="CaretBrush" Value="{DynamicResource AccentBrush}" />
        <!-- 同 InputBox：描边交给外层 Border，BorderThickness 归零 -->
        <Setter Property="BorderThickness" Value="0" />
        <Setter Property="Padding" Value="13,0" />
        <Setter Property="Height" Value="36" />
        <Setter Property="FontFamily" Value="{StaticResource UiFont}" />
        <Setter Property="FontSize" Value="12.5" />
        <Setter Property="VerticalContentAlignment" Value="Center" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="PasswordBox">
                    <!-- 两层同心 Border 抗锯齿，原理见 InputBox 模板注释 -->
                    <Border x:Name="bdStroke" CornerRadius="8"
                            Background="{DynamicResource BorderHiBrush}">
                        <Border x:Name="bdFill" CornerRadius="7" Margin="1"
                                Background="{TemplateBinding Background}">
                            <!--
                              ★ 这里不再写 Margin="{TemplateBinding Padding}"。
                              PART_ContentHost 是 ScrollViewer，它的 Padding 已经继承了
                              PasswordBox 的 Padding —— 再加一次 Margin 就是**双倍缩进**，
                              和 InputBox 早期那个「占位与光标对不上」是同一个根因。
                            -->
                            <ScrollViewer x:Name="PART_ContentHost"
                                          VerticalAlignment="Center" />
                        </Border>
                    </Border>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsKeyboardFocusWithin" Value="True">
                            <Setter TargetName="bdStroke" Property="Background"
                                    Value="{DynamicResource AccentBrush}" />
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!-- ============================================================
         复选框：自绘对勾（避免系统主题把勾画成叉）

         ★ 17×17 配 CornerRadius=5 时，弧段占边长的比例很大，
         BorderThickness 的「内外沿长度不等」在这里最明显 ——
         选中态整块填充时混色带尤其显眼。所以这里同样改成
         外层描边 + 内层 Margin=1 填充，半径 5 → 4。
         ============================================================ -->
    <Style x:Key="FlatCheck" TargetType="CheckBox">
        <Setter Property="Foreground" Value="{DynamicResource TextBrush}" />
        <Setter Property="FontFamily" Value="{StaticResource UiFont}" />
        <Setter Property="FontSize" Value="12.5" />
        <Setter Property="Cursor" Value="Hand" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="CheckBox">
                    <StackPanel Orientation="Horizontal" Background="Transparent">
                        <!--
                          外层 17×17 / R5 是描边；内层 Margin=1 → 15×15 / R4 是填充。
                          对勾画在**外层**（不受 Margin 影响），坐标沿用原来的
                          17×17 画布，视觉位置不变。
                        -->
                        <Grid Width="17" Height="17" VerticalAlignment="Center">
                            <Border x:Name="boxStroke" CornerRadius="5"
                                    Background="{DynamicResource BorderHiBrush}" />
                            <Border x:Name="boxFill" CornerRadius="4" Margin="1"
                                    Background="{DynamicResource SurfaceHiBrush}" />
                            <Path x:Name="tick" Data="M 3.8,8.8 L 6.9,12 L 13.2,4.6"
                                  Stroke="#FFFFFF" StrokeThickness="2.4"
                                  StrokeStartLineCap="Round" StrokeEndLineCap="Round"
                                  StrokeLineJoin="Round" Visibility="Collapsed" />
                        </Grid>
                        <ContentPresenter Margin="9,0,0,0" VerticalAlignment="Center" />
                    </StackPanel>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter TargetName="boxStroke" Property="Background"
                                    Value="{DynamicResource AccentBrush}" />
                        </Trigger>
                        <Trigger Property="IsChecked" Value="True">
                            <!-- 选中态：描边与填充同色（纯色块，无混色带） -->
                            <Setter TargetName="boxStroke" Property="Background"
                                    Value="{DynamicResource AccentBrush}" />
                            <Setter TargetName="boxFill" Property="Background"
                                    Value="{DynamicResource AccentBrush}" />
                            <Setter TargetName="tick" Property="Visibility" Value="Visible" />
                        </Trigger>
                        <Trigger Property="IsEnabled" Value="False">
                            <Setter Property="Opacity" Value="0.5" />
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!-- ============================================================
         滚动条：极细，悬停加粗
         ============================================================ -->
    <Style x:Key="SlimScrollBar" TargetType="ScrollBar">
        <Setter Property="Width" Value="10" />
        <Setter Property="Background" Value="Transparent" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="ScrollBar">
                    <Grid Background="Transparent">
                        <Track x:Name="PART_Track" IsDirectionReversed="True">
                            <Track.Thumb>
                                <Thumb>
                                    <Thumb.Template>
                                        <ControlTemplate TargetType="Thumb">
                                            <Border x:Name="t" Background="#39404D"
                                                    CornerRadius="3" Width="5"
                                                    HorizontalAlignment="Center"
                                                    Margin="0,3" />
                                            <ControlTemplate.Triggers>
                                                <Trigger Property="IsMouseOver" Value="True">
                                                    <Setter TargetName="t" Property="Background"
                                                            Value="#5A6472" />
                                                    <Setter TargetName="t" Property="Width"
                                                            Value="7" />
                                                </Trigger>
                                            </ControlTemplate.Triggers>
                                        </ControlTemplate>
                                    </Thumb.Template>
                                </Thumb>
                            </Track.Thumb>
                        </Track>
                    </Grid>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <Style x:Key="SlimScrollViewer" TargetType="ScrollViewer">
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="ScrollViewer">
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <ScrollContentPresenter Grid.Column="0" CanContentScroll="False" />
                        <ScrollBar Grid.Column="1" x:Name="PART_VerticalScrollBar"
                                   Orientation="Vertical"
                                   Style="{StaticResource SlimScrollBar}"
                                   Value="{TemplateBinding VerticalOffset}"
                                   Maximum="{TemplateBinding ScrollableHeight}"
                                   ViewportSize="{TemplateBinding ViewportHeight}"
                                   Visibility="{TemplateBinding ComputedVerticalScrollBarVisibility}" />
                    </Grid>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!-- ============================================================
         卡片：默认带 1px 低对比描边，用于分组
         ============================================================ -->
    <Style x:Key="Card" TargetType="Border">
        <Setter Property="Background" Value="{DynamicResource SurfaceBrush}" />
        <Setter Property="BorderBrush" Value="{DynamicResource BorderBrush}" />
        <Setter Property="BorderThickness" Value="1" />
        <Setter Property="CornerRadius" Value="10" />
    </Style>

    <Style x:Key="CardFlat" TargetType="Border">
        <Setter Property="Background" Value="{DynamicResource SurfaceHiBrush}" />
        <Setter Property="BorderThickness" Value="0" />
        <Setter Property="CornerRadius" Value="10" />
    </Style>

    <!-- 示例链接 chip：小尺寸、强调色文字、悬停加底色 -->
    <Style x:Key="SampleChip" TargetType="Button">
        <Setter Property="Foreground" Value="{DynamicResource AccentBrush}" />
        <Setter Property="Background" Value="Transparent" />
        <Setter Property="BorderThickness" Value="1" />
        <Setter Property="BorderBrush" Value="#2A3550" />
        <Setter Property="FontFamily" Value="{StaticResource UiFont}" />
        <Setter Property="FontSize" Value="11" />
        <Setter Property="Padding" Value="9,3" />
        <Setter Property="Margin" Value="0,0,7,0" />
        <Setter Property="Cursor" Value="Hand" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="Button">
                    <Border x:Name="bd" Background="{TemplateBinding Background}"
                            BorderBrush="{TemplateBinding BorderBrush}"
                            BorderThickness="{TemplateBinding BorderThickness}"
                            CornerRadius="5">
                        <ContentPresenter HorizontalAlignment="Center"
                                          VerticalAlignment="Center"
                                          Margin="{TemplateBinding Padding}" />
                    </Border>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter TargetName="bd" Property="Background"
                                    Value="{DynamicResource AccentSoftBrush}" />
                            <Setter TargetName="bd" Property="BorderBrush"
                                    Value="{DynamicResource AccentBrush}" />
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>


    <!-- ============================================================
         ComboBox：必须自绘，系统默认模板是浅色
         ============================================================ -->
    <Style x:Key="FlatComboBox" TargetType="ComboBox">
        <Setter Property="Foreground" Value="{DynamicResource TextBrush}" />
        <Setter Property="Background" Value="{DynamicResource SurfaceHiBrush}" />
        <Setter Property="BorderBrush" Value="{DynamicResource BorderHiBrush}" />
        <Setter Property="BorderThickness" Value="1" />
        <Setter Property="FontFamily" Value="{StaticResource UiFont}" />
        <Setter Property="FontSize" Value="12.5" />
        <!-- 高度与 InputBox 对齐（36）：同一张卡片里输入框和下拉框并排时不能一高一矮 -->
        <Setter Property="Height" Value="36" />
        <Setter Property="Padding" Value="11,0" />
        <Setter Property="Cursor" Value="Hand" />
        <Setter Property="HorizontalContentAlignment" Value="Left" />
        <Setter Property="VerticalContentAlignment" Value="Center" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="ComboBox">
                    <Grid>
                        <ToggleButton x:Name="Toggle"
                                      Focusable="False" ClickMode="Press"
                                      IsChecked="{Binding IsDropDownOpen,
                                        RelativeSource={RelativeSource TemplatedParent},
                                        Mode=TwoWay}">
                            <ToggleButton.Template>
                                <ControlTemplate TargetType="ToggleButton">
                                    <!--
                                      圆角描边用「外层纯色 + 内层 Margin=1」（R8 → 内层 R7），
                                      不用 BorderThickness：弧段上 1px 环会被拉成斜向宽带，
                                      出现描边×填充的混色脏边。
                                    -->
                                    <Border x:Name="tbdStroke" CornerRadius="8"
                                            Background="{DynamicResource BorderHiBrush}">
                                    <Border x:Name="tbd" CornerRadius="7" Margin="1"
                                            Background="{DynamicResource SurfaceHiBrush}">
                                        <Grid>
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="*" />
                                                <ColumnDefinition Width="Auto" />
                                            </Grid.ColumnDefinitions>
                                            <ContentPresenter Grid.Column="0"
                                                              Margin="{TemplateBinding Padding}"
                                                              VerticalAlignment="Center"
                                                              HorizontalAlignment="Left" />
                                            <Path Grid.Column="1" Data="{StaticResource IconChevronDown}"
                                                  Width="12" Height="12" Stretch="Uniform"
                                                  Margin="0,0,11,0" VerticalAlignment="Center"
                                                  Fill="{DynamicResource TextMutedBrush}" />
                                        </Grid>
                                    </Border>
                                    </Border>
                                    <ControlTemplate.Triggers>
                                        <Trigger Property="IsMouseOver" Value="True">
                                            <Setter TargetName="tbdStroke" Property="Background"
                                                    Value="{DynamicResource AccentBrush}" />
                                        </Trigger>
                                    </ControlTemplate.Triggers>
                                </ControlTemplate>
                            </ToggleButton.Template>
                        </ToggleButton>

                        <ContentPresenter x:Name="Selection"
                                          Content="{TemplateBinding SelectionBoxItem}"
                                          ContentTemplate="{TemplateBinding SelectionBoxItemTemplate}"
                                          Margin="{TemplateBinding Padding}"
                                          VerticalAlignment="Center"
                                          HorizontalAlignment="Left"
                                          IsHitTestVisible="False" />

                        <Popup x:Name="PART_Popup" AllowsTransparency="True"
                               Placement="Bottom" Focusable="False"
                               IsOpen="{TemplateBinding IsDropDownOpen}"
                               PopupAnimation="Fade">
                            <!-- 圆角描边：外层纯色 + 内层 Margin=1（R8 → 内层 R7） -->
                            <Border CornerRadius="8"
                                    Background="{DynamicResource BorderHiBrush}"
                                    Margin="0,4,0,0"
                                    MinWidth="{TemplateBinding ActualWidth}"
                                    MaxHeight="{TemplateBinding MaxDropDownHeight}">
                                <Border.Effect>
                                    <DropShadowEffect Color="#000000" BlurRadius="16"
                                                      ShadowDepth="3" Opacity="0.45" />
                                </Border.Effect>
                                <Border CornerRadius="7" Margin="1"
                                        Background="{DynamicResource SurfaceTopBrush}">
                                <ScrollViewer Style="{StaticResource SlimScrollViewer}"
                                              VerticalScrollBarVisibility="Auto"
                                              Margin="0,4">
                                    <ItemsPresenter />
                                </ScrollViewer>
                                </Border>
                            </Border>
                        </Popup>
                    </Grid>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsEnabled" Value="False">
                            <Setter Property="Opacity" Value="0.45" />
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <Style x:Key="FlatComboBoxItem" TargetType="ComboBoxItem">
        <Setter Property="Foreground" Value="{DynamicResource TextBrush}" />
        <Setter Property="FontFamily" Value="{StaticResource UiFont}" />
        <Setter Property="FontSize" Value="12.5" />
        <Setter Property="Padding" Value="11,7" />
        <Setter Property="Cursor" Value="Hand" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="ComboBoxItem">
                    <Border x:Name="bd" Background="Transparent" CornerRadius="5"
                            Margin="4,1" Padding="{TemplateBinding Padding}">
                        <ContentPresenter VerticalAlignment="Center" />
                    </Border>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsHighlighted" Value="True">
                            <Setter TargetName="bd" Property="Background"
                                    Value="{DynamicResource AccentSoftBrush}" />
                        </Trigger>
                        <Trigger Property="IsSelected" Value="True">
                            <Setter TargetName="bd" Property="Background"
                                    Value="{DynamicResource AccentSoftBrush}" />
                            <Setter Property="Foreground"
                                    Value="{DynamicResource AccentHiBrush}" />
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!-- 让 ComboBox 默认就用深色模板 -->
    <Style TargetType="ComboBox" BasedOn="{StaticResource FlatComboBox}" />
    <Style TargetType="ComboBoxItem" BasedOn="{StaticResource FlatComboBoxItem}" />

    <!-- ============================================================
         徽章
         ============================================================ -->
    <Style x:Key="Badge" TargetType="Border">
        <Setter Property="Background" Value="{DynamicResource SurfaceTopBrush}" />
        <Setter Property="CornerRadius" Value="5" />
        <Setter Property="Padding" Value="7,2.5" />
        <Setter Property="VerticalAlignment" Value="Center" />
    </Style>

    <!-- ============================================================
         工具提示
         之前整个项目没有 ToolTip 样式，用的是系统默认 —— 深色界面上
         弹出一个白底黑字的方框，非常刺眼。这里给全局默认样式，不用每处单独指定。
         ============================================================ -->
    <Style TargetType="ToolTip">
        <Setter Property="Foreground" Value="{DynamicResource TextBrush}" />
        <Setter Property="Background" Value="{DynamicResource SurfaceTopBrush}" />
        <Setter Property="BorderBrush" Value="{DynamicResource BorderBrush}" />
        <Setter Property="BorderThickness" Value="1" />
        <Setter Property="Padding" Value="9,6" />
        <Setter Property="FontFamily" Value="{StaticResource UiFont}" />
        <Setter Property="FontSize" Value="11.5" />
        <Setter Property="MaxWidth" Value="420" />
        <Setter Property="TextOptions.TextFormattingMode" Value="Display" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="ToolTip">
                    <Border Background="{TemplateBinding Background}"
                            BorderBrush="{TemplateBinding BorderBrush}"
                            BorderThickness="{TemplateBinding BorderThickness}"
                            CornerRadius="6"
                            Padding="{TemplateBinding Padding}"
                            SnapsToDevicePixels="True">
                        <ContentPresenter />
                    </Border>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!-- ============================================================
         设置项开关（iOS 风格滑动开关）
         形态：左侧文字、右侧胶囊轨道 + 可滑动圆钮。

         【为什么还是 CheckBox 而不是 ToggleButton】
         语义上这就是"勾选/不勾选"两态，CheckBox 天然带 IsChecked，
         ViewModel 绑定一行都不用改。ControlTemplate 整个重画，
         外观与原生的勾选框毫无关系。

         【整行可点】
         HorizontalAlignment=Stretch 让 Grid 铺满容器，
         "文字 + 空白 + 开关"整行都是热区，和系统设置页一致，
         不必精确点到那个小开关上。

         【滑块用 Margin 动画而不是 TranslateTransform】
         Margin 由布局系统处理，动画结束后位置仍由布局约束保证正确；
         TranslateTransform 是渲染期变换，父容器尺寸一变就要重算终点。

         【必须写对称的退出动画】
         Enter 的动画是 HoldEnd，会一直占住 Margin；不给回程动画，
         滑块会卡在右侧不动。
         ============================================================ -->
    <Style x:Key="ToggleSwitch" TargetType="CheckBox">
        <Setter Property="FontFamily" Value="{StaticResource UiFont}" />
        <Setter Property="FontSize" Value="12.5" />
        <Setter Property="Foreground" Value="{DynamicResource TextBrush}" />
        <Setter Property="Cursor" Value="Hand" />
        <!-- 撑满整行，开关才能真的贴到最右 -->
        <Setter Property="HorizontalAlignment" Value="Stretch" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="CheckBox">
                    <Grid Background="Transparent" MinHeight="30">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>

                        <ContentPresenter Grid.Column="0" VerticalAlignment="Center"
                                          Margin="0,0,14,0" />

                        <!-- 轨道：深色主题下"关"用比卡片更深的填充 + 描边，
                             形成"凹槽"感；"开"变成强调蓝，两态一眼能分清。
                             早先用 SurfaceTopBrush 太接近卡片底色，
                             截图里开关的开/关几乎看不出区别。 -->
                        <Border x:Name="TrackStroke" Grid.Column="1"
                                Width="43" Height="25" CornerRadius="12.5"
                                Background="#FF3D4553"
                                VerticalAlignment="Center"
                                SnapsToDevicePixels="True"
                                UseLayoutRounding="True">
                        <Border x:Name="Track"
                                CornerRadius="11.5" Margin="1"
                                Background="#FF2E3440"
                                VerticalAlignment="Center"
                                SnapsToDevicePixels="True"
                                UseLayoutRounding="True">
                            <!-- 滑块：关=灰白小圆，开=纯白，配合轨道变色形成对比

                                 ★ 尺寸全部取半像素（43x25 / r12.5，滑块 19 / r9.5）。
                                   原因：Border 的 CornerRadius 由 WPF 用几何抗锯齿绘制，
                                   边缘必然带一圈半透明像素。正方形滑块半径恰为边长一半时，
                                   圆心会落在像素中心线上 —— 那圈半透明边与底下轨道的描边
                                   再混一次，视觉上就是「滑块周围发灰的晕圈」。
                                   把整体尺寸做成奇数、半径做成 x.5，边缘正好落在像素边界，
                                   晕圈消失（3 倍放大对比截图验证过）。 -->
                            <Border x:Name="Knob" Width="19" Height="19"
                                    CornerRadius="9.5" Background="#FFA8B0BD"
                                    HorizontalAlignment="Left" VerticalAlignment="Center"
                                    Margin="2.5,0,0,0"
                                    SnapsToDevicePixels="True"
                                    UseLayoutRounding="True" />
                        </Border>
                        </Border>
                    </Grid>

                    <ControlTemplate.Triggers>
                        <Trigger Property="IsChecked" Value="True">
                            <Setter TargetName="TrackStroke" Property="Background"
                                    Value="{DynamicResource AccentBrush}" />
                            <Setter TargetName="Track" Property="Background"
                                    Value="{DynamicResource AccentBrush}" />
                            <Setter TargetName="Knob" Property="Background" Value="#FFFFFFFF" />

                            <Trigger.EnterActions>
                                <BeginStoryboard>
                                    <Storyboard>
                                        <!-- 位移 = 轨道宽 - 滑块宽 - 左右各 2px - 边框 2px -->
                                        <ThicknessAnimation
                                            Storyboard.TargetName="Knob"
                                            Storyboard.TargetProperty="Margin"
                                            To="19,0,0,0" Duration="0:0:0.15">
                                            <ThicknessAnimation.EasingFunction>
                                                <CubicEase EasingMode="EaseOut" />
                                            </ThicknessAnimation.EasingFunction>
                                        </ThicknessAnimation>
                                    </Storyboard>
                                </BeginStoryboard>
                            </Trigger.EnterActions>

                            <Trigger.ExitActions>
                                <BeginStoryboard>
                                    <Storyboard>
                                        <ThicknessAnimation
                                            Storyboard.TargetName="Knob"
                                            Storyboard.TargetProperty="Margin"
                                            To="2.5,0,0,0" Duration="0:0:0.15">
                                            <ThicknessAnimation.EasingFunction>
                                                <CubicEase EasingMode="EaseOut" />
                                            </ThicknessAnimation.EasingFunction>
                                        </ThicknessAnimation>
                                    </Storyboard>
                                </BeginStoryboard>
                            </Trigger.ExitActions>
                        </Trigger>

                        <!-- 悬停只降一点不透明度，不做位移，避免误以为已切换 -->
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter TargetName="Track" Property="Opacity" Value="0.85" />
                        </Trigger>

                        <Trigger Property="IsEnabled" Value="False">
                            <Setter Property="Opacity" Value="0.45" />
                            <Setter Property="Cursor" Value="Arrow" />
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!--
        环形转圈指示器。

        用两个 Ellipse + StrokeDashArray 模拟「缺口圆环」，靠 RotateTransform 旋转。
        不用 ProgressBar 的 IsIndeterminate：它的默认模板是高 4px 的横条，
        在遮罩中央显得太弱，也不像「正在处理」。

        ★ RenderTransformOrigin 必须 0.5,0.5 —— 否则旋转轴在左上角，圆环会甩出视野。
    -->
    <Style x:Key="BusyRing" TargetType="Grid">
        <Setter Property="Width" Value="34" />
        <Setter Property="Height" Value="34" />
        <Setter Property="RenderTransformOrigin" Value="0.5,0.5" />
        <Setter Property="RenderTransform">
            <Setter.Value>
                <RotateTransform Angle="0" />
            </Setter.Value>
        </Setter>
        <Style.Triggers>
            <Trigger Property="IsVisible" Value="True">
                <Trigger.EnterActions>
                    <BeginStoryboard Name="SpinStory">
                        <Storyboard RepeatBehavior="Forever">
                            <DoubleAnimation Storyboard.TargetProperty="(UIElement.RenderTransform).(RotateTransform.Angle)"
                                             From="0" To="360" Duration="0:0:0.9" />
                        </Storyboard>
                    </BeginStoryboard>
                </Trigger.EnterActions>
                <Trigger.ExitActions>
                    <StopStoryboard BeginStoryboardName="SpinStory" />
                </Trigger.ExitActions>
            </Trigger>
        </Style.Triggers>
    </Style>

</ResourceDictionary>
