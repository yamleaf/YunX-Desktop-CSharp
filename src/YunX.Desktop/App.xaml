<Application x:Class="YunX.Desktop.App"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:conv="clr-namespace:YunX.Desktop.Converters">
    <Application.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <!--
                    顺序有依赖：Dark.xaml 的 ComboBox 模板里用 {StaticResource IconChevronDown}，
                    StaticResource 在合并字典中是**解析时**查找的，
                    所以 Icons.xaml 必须排在前面，否则报「无法找到资源 IconChevronDown」。
                -->
                <ResourceDictionary Source="Themes/Icons.xaml" />
                <ResourceDictionary Source="Themes/Dark.xaml" />
            </ResourceDictionary.MergedDictionaries>

            <conv:BoolToVisibilityConverter x:Key="BoolToVis" />
            <conv:InverseBoolToVisibilityConverter x:Key="InverseBoolToVis" />
            <conv:PercentToWidthConverter x:Key="PercentToWidth" />
            <conv:StateToBrushConverter x:Key="StateToBrush" />
            <conv:EmptyToVisibilityConverter x:Key="EmptyToVis" />
            <conv:NullToVisibilityConverter x:Key="NullToVis" />
            <conv:EnumEqualsConverter x:Key="EnumEquals" />
            <conv:InverseBoolConverter x:Key="InverseBool" />
            <conv:StringNotEmptyToVisibilityConverter x:Key="NotEmptyToVis" />
            <conv:StateToGeoConverter x:Key="StateToGeo" />
        </ResourceDictionary>
    </Application.Resources>
</Application>
